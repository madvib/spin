{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "bun-types",
      "vite/client"
    ],
    "paths": {
      "@spinjs/theme": [
        "./packages/theme/src/index.ts"
      ],
      "@spinjs/theme/*": [
        "./packages/theme/src/*"
      ],
      "@spinjs/preset": [
        "./packages/preset/src/index.ts"
      ],
      "@spinjs/preset/*": [
        "./packages/preset/src/*"
      ],
      "@spinjs/server": [
        "./packages/server/src/index.ts"
      ],
      "@spinjs/server/*": [
        "./packages/server/src/*"
      ],
      "@spinjs/components": [
        "./packages/components/src/index.ts"
      ],
      "@spinjs/components/*": [
        "./packages/components/src/*"
      ],
      "@spinjs/dev": [
        "./packages/dev/src/plugin/plugin.ts"
      ],
      "@spinjs/dev/preset": [
        "./packages/dev/src/preset.ts"
      ],
      "@spinjs/dev/preset/css": [
        "./packages/dev/src/preset-css.ts"
      ],
      "@spinjs/dev/preset/elements": [
        "./packages/dev/src/elements.d.ts"
      ],
      "@spinjs/dev/elements": [
        "./packages/dev/src/elements.d.ts"
      ],
      "@spinjs/dev/theme": [
        "./packages/dev/src/theme.ts"
      ],
      "@spinjs/dev/theme/base": [
        "./packages/dev/src/theme-base.ts"
      ],
      "@spinjs/dev/theme/theme-types": [
        "./packages/dev/src/theme-types.d.ts"
      ],
      "@spinjs/dev/diagnostics": [
        "./packages/dev/src/diagnostics.ts"
      ],
      "@spinjs/dev/eslint": [
        "./packages/dev/src/eslint.ts"
      ],
      "@spinjs/dev/vite": [
        "./packages/dev/src/plugin/plugin.ts"
      ],
      "@spinjs/dev/cli": [
        "./packages/dev/src/cli/main.ts"
      ],
      "@spinjs/dev/*": [
        "./packages/dev/src/*"
      ],
      "@spinjs/preset/elements": [
        "./packages/preset/src/elements.d.ts"
      ],
      "@spinjs/diagnostics": [
        "./packages/diagnostics/src/index.ts"
      ],
      "@spinjs/diagnostics/*": [
        "./packages/diagnostics/src/*"
      ],
      "@spinjs/build": [
        "./packages/build/src/index.ts"
      ],
      "@spinjs/build/*": [
        "./packages/build/src/*"
      ]
    }
  },
  "include": [
    "packages",
    "scripts",
    "internal"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**"
  ]
}
