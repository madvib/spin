{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@spinjs/theme": [
        "../../packages/theme/src/index.ts"
      ],
      "@spinjs/theme/themes": [
        "../../packages/theme/src/themes/index.ts"
      ],
      "@spinjs/theme/theme-types": [
        "../../packages/theme/src/theme-types.d.ts"
      ],
      "@spinjs/kit": [
        "../../packages/kit/src/index.ts"
      ],
      "@spinjs/api/client": [
        "../../packages/api/src/client.ts"
      ],
      "@spinjs/api": [
        "../../packages/api/src/index.ts"
      ],
      "@spinjs/project": [
        "../../packages/project/src/index.ts"
      ],
      "@spinjs/project/sync": [
        "../../packages/project/src/sync.ts"
      ],
      "@spinjs/diagnostics": [
        "../../packages/diagnostics/src/index.ts"
      ],
      "@spinjs/preset": [
        "../../packages/preset/src/index.ts"
      ],
      "@spinjs/preset/config": [
        "../../packages/preset/src/config.ts"
      ],
      "@unocss/core": [
        "./node_modules/@unocss/core/dist/index.d.mts"
      ],
      "@spinjs/theme/base": [
        "../../packages/theme/src/base/index.ts"
      ],
      "@spinjs/animation": [
        "../../packages/animation/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "../../packages/preset/src/solid.d.ts",
    "vite.config.ts"
  ],
  "exclude": [
    // Deno's own tests: they run under `deno test`, which type-checks them
    // against Deno's types and the import map. tsc has neither, so including
    // them here would fail the build on `Deno.test` while proving nothing the
    // test task does not already prove.
    "src/**/*.test.ts"
  ]
}
