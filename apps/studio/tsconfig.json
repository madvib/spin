{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@spinjs/theme": [
        "../../packages/spin/src/theme/index.ts"
      ],
      "@spinjs/theme/themes": [
        "../../packages/spin/src/theme/themes/index.ts"
      ],
      "@spinjs/theme/theme-types": [
        "../../packages/spin/src/theme/theme-types.d.ts"
      ],
      "@spinjs/kit": [
        "../../packages/spin/src/kit/index.ts"
      ],
      "@spinjs/api/client": [
        "../../packages/spin/src/api/client.ts"
      ],
      "@spinjs/api": [
        "../../packages/spin/src/api/index.ts"
      ],
      "@spinjs/project": [
        "../../packages/spin/src/project/index.ts"
      ],
      "@spinjs/project/sync": [
        "../../packages/spin/src/project/sync.ts"
      ],
      "@spinjs/diagnostics": [
        "../../packages/spin/src/diagnostics/index.ts"
      ],
      "@spinjs/preset": [
        "../../packages/spin/src/preset/index.ts"
      ],
      "@spinjs/preset/config": [
        "../../packages/spin/src/preset/config.ts"
      ],
      "@unocss/core": [
        "./node_modules/@unocss/core/dist/index.d.mts"
      ],
      "@spinjs/theme/base": [
        "../../packages/spin/src/theme/base/index.ts"
      ],
      "@spinjs/animation": [
        "../../packages/spin/src/animation/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "../../packages/spin/src/preset/solid.d.ts",
    "vite.config.ts"
  ],
  "exclude": [
    // Deno's own tests: they run under `deno test`, which type-checks them
    // against Deno's types and the import map. tsc has neither, so including
    // them here would fail the build on `Deno.test` while proving nothing the
    // test task does not already prove.
    "src/**/*.test.ts"
  ]
}
