{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "types": [
      "vite/client",
      "bun-types"
    ],
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "src/lib/components/*.html": [
        "./src/lib/components/*.html"
      ],
      "@spinjs/components/examples": [
        "../../packages/components/src/examples.ts"
      ],
      "@spinjs/theme": [
        "../../packages/theme/src/index.ts"
      ],
      "@spinjs/kit": [
        "../../internal/kit/src/index.ts"
      ],
      "@spinjs/dev/examples": [
        "../../packages/dev/src/examples/index.ts"
      ],
      "@spinjs/dev/api": [
        "../../packages/dev/src/api/index.ts"
      ],
      "@spinjs/dev/api/client": [
        "../../packages/dev/src/api/client.ts"
      ],
      "@spinjs/dev/vite": [
        "../../packages/dev/src/plugin/plugin.ts"
      ],
      "@spinjs/diagnostics": [
        "../../packages/diagnostics/src/index.ts"
      ],
      "@spinjs/preset": [
        "../../packages/preset/src/index.ts"
      ],
      "@spinjs/theme/base": [
        "../../packages/theme/src/base/index.ts"
      ],
      "@spinjs/preset/elements": [
        "../../packages/preset/src/elements.d.ts"
      ],
      "@spinjs/build": [
        "../../packages/build/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
