{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "types": [
      "vite/client",
      "bun-types"
    ],
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "src/lib/components/*.html": [
        "./src/lib/components/*.html"
      ],
      "@spinjs/components/examples": [
        "../../packages/components/src/examples.ts"
      ],
      "@spinjs/spin/theme": [
        "../../packages/spin/src/theme/index.ts"
      ],
      "@spinjs/spin/theme/themes": [
        "../../packages/spin/src/theme/themes/index.ts"
      ],
      "@spinjs/kit": [
        "../../internal/kit/src/index.ts"
      ],
      "@spinjs/spin/examples": [
        "../../packages/spin/src/examples/index.ts"
      ],
      "@spinjs/api/client": [
        "../../packages/spin/src/api/client.ts"
      ],
      "@spinjs/api": [
        "../../packages/spin/src/api/index.ts"
      ],
      "@spinjs/project": [
        "../../packages/spin/src/project/index.ts"
      ],
      "@spinjs/project/sync": [
        "../../packages/spin/src/project/sync.ts"
      ],
      "@spinjs/diagnostics": [
        "../../packages/spin/src/diagnostics/index.ts"
      ],
      "@spinjs/preset": [
        "../../packages/spin/src/compiler/index.ts"
      ],
      "@spinjs/preset/config": [
        "../../packages/spin/src/plugin/config.ts"
      ],
      "@spinjs/spin/theme/base": [
        "../../packages/spin/src/theme/base/index.ts"
      ],
      "@spinjs/animation": [
        "../../packages/spin/src/animation/index.ts"
      ],
      "@spinjs/spin/elements": [
        "../../packages/spin/src/compiler/elements.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
