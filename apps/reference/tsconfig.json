{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "types": [
      "vite/client",
      "bun-types"
    ],
    "paths": {
      "@spinjs/components": [
        "../../packages/components/src/index.ts"
      ],
      "@spinjs/components/*": [
        "../../packages/components/src/*"
      ],
      "@spinjs/components/examples": [
        "../../packages/components/src/examples.ts"
      ],
      "@spinjs/kit": [
        "../../internal/kit/src/index.ts"
      ],
      "@spinjs/spin/examples": [
        "../../packages/spin/src/examples/index.ts"
      ],
      "@spinjs/preset": [
        "../../packages/preset/src/index.ts"
      ],
      "@spinjs/animation": [
        "../../packages/preset/src/animation/index.ts"
      ],
      "@spinjs/spin/vite": [
        "../../packages/spin/src/plugin/plugin.ts"
      ],
      "@spinjs/spin/preset": [
        "../../packages/preset/src/index.ts"
      ],
      "@spinjs/theme": [
        "../../packages/theme/src/index.ts"
      ],
      "@spinjs/theme/themes": [
        "../../packages/theme/src/themes/index.ts"
      ],
      "@spinjs/spin/api": [
        "../../packages/spin/src/api/index.ts"
      ],
      "@spinjs/spin/skill": [
        "../../packages/spin/src/skill/index.ts"
      ],
      "@spin/check": [
        "../../internal/check/harness.ts"
      ],
      "@spinjs/preset/elements": [
        "../../packages/preset/src/elements.d.ts"
      ],
      "@spinjs/build": [
        "../../packages/build/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "visual",
    "vite.config.ts"
  ]
}
