{
  "$extensions": {
    "spin": {
      "id": "neobrut",
      "modes": [
        "light"
      ]
    }
  },
  "color": {
    "$type": "color",
    "surface": {
      "$value": "oklch(97% 0 0)",
      "$type": "color"
    },
    "surface-raised": {
      "$value": "oklch(100% 0 0)",
      "$type": "color"
    },
    "text": {
      "$value": "oklch(14% 0 0)",
      "$type": "color"
    },
    "text-muted": {
      "$value": "oklch(38% 0 0)",
      "$type": "color"
    },
    "primary": {
      "$value": "oklch(14% 0 0)",
      "$description": "Ink primary, same as text. Brutalist actions are black.",
      "$type": "color"
    },
    "secondary": {
      "$value": "oklch(38% 0 0)",
      "$description": "Secondary actions in muted ink.",
      "$type": "color"
    },
    "accent": {
      "$value": "#D92D20",
      "$description": "Single hot accent, authored (no sail source).",
      "$type": "color"
    },
    "semantic": {
      "$description": "Status colors. Named by meaning, never by hue.",
      "success": {
        "$value": "#15803d",
        "$type": "color"
      },
      "warning": {
        "$value": "#a16207",
        "$type": "color"
      },
      "error": {
        "$value": "#D92D20",
        "$type": "color"
      },
      "info": {
        "$value": "#0369a1",
        "$type": "color"
      }
    },
    "border": {
      "$value": "oklch(14% 0 0)",
      "$type": "color"
    },
    "on-primary": {
      "$value": "oklch(100% 0 0)",
      "$type": "color"
    },
    "on-danger": {
      "$value": "oklch(100% 0 0)",
      "$type": "color"
    },
    "focus-ring": {
      "$value": "{color.accent}"
    },
    "link": {
      "$value": "{color.accent}",
      "$description": "Links must read against body text, so they use the accent rather than the ink primary."
    }
  },
  "spacing": {
    "0": {
      "$value": "0"
    },
    "1": {
      "$value": "0.25rem"
    },
    "2": {
      "$value": "0.5rem"
    },
    "4": {
      "$value": "1rem"
    },
    "8": {
      "$value": "2rem"
    },
    "16": {
      "$value": "4rem"
    },
    "$type": "dimension",
    "$description": "The spacing scale. Every gap, pad and inset is one of these steps."
  },
  "font": {
    "$description": "Typography: which face, how large, how heavy.",
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": "Inter, ui-sans-serif, system-ui, sans-serif",
        "$description": "Body and UI text."
      },
      "serif": {
        "$value": "ui-serif, Georgia, Cambria, serif",
        "$description": "Long-form editorial text."
      },
      "mono": {
        "$value": "ui-monospace, SFMono-Regular, Menlo, monospace",
        "$description": "Code, identifiers, tabular figures."
      }
    },
    "size": {
      "$type": "dimension",
      "xs": {
        "$value": "0.75rem"
      },
      "sm": {
        "$value": "0.875rem"
      },
      "md": {
        "$value": "1rem"
      },
      "lg": {
        "$value": "1.125rem"
      },
      "xl": {
        "$value": "1.25rem"
      },
      "2xl": {
        "$value": "1.5rem"
      },
      "3xl": {
        "$value": "1.875rem"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Corner rounding, from square to fully round.",
    "none": {
      "$value": "0"
    },
    "sm": {
      "$value": "0px",
      "$type": "dimension"
    },
    "md": {
      "$value": "0px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "0px",
      "$type": "dimension"
    },
    "full": {
      "$value": "9999px"
    },
    "xl": {
      "$value": "0px",
      "$type": "dimension"
    }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Elevation, as CSS box-shadow values.",
    "sm": {
      "$value": "none",
      "$type": "shadow"
    },
    "md": {
      "$value": "none",
      "$type": "shadow"
    },
    "lg": {
      "$value": "none",
      "$type": "shadow"
    },
    "xs": {
      "$value": "none",
      "$type": "shadow"
    },
    "xl": {
      "$value": "none",
      "$type": "shadow"
    },
    "card-rest": {
      "$value": "none",
      "$type": "shadow"
    },
    "hover": {
      "$value": "none",
      "$type": "shadow"
    },
    "sticky": {
      "$value": "none",
      "$type": "shadow"
    },
    "accent": {
      "$value": "0 0 0 3px oklch(0.62 0.24 28 / 40%)",
      "$type": "shadow"
    },
    "inset-soft": {
      "$value": "none",
      "$type": "shadow"
    },
    "edge-top": {
      "$value": "none",
      "$type": "shadow"
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "$description": "Viewport widths where layout steps change.",
    "sm": {
      "$value": "40rem"
    },
    "md": {
      "$value": "48rem"
    },
    "lg": {
      "$value": "64rem"
    },
    "xl": {
      "$value": "80rem"
    }
  },
  "z-index": {
    "$type": "number",
    "$description": "Stacking order. Layer, never a magic number at the call site.",
    "base": {
      "$value": 0
    },
    "dropdown": {
      "$value": 1000
    },
    "modal": {
      "$value": 2000
    },
    "toast": {
      "$value": 3000
    }
  },
  "motion": {
    "$description": "How things move and how long it takes.",
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "150ms"
      },
      "base": {
        "$value": "250ms"
      },
      "slow": {
        "$value": "400ms"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "linear": {
        "$value": "linear"
      },
      "standard": {
        "$value": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "decelerate": {
        "$value": "cubic-bezier(0, 0, 0, 1)"
      },
      "accelerate": {
        "$value": "cubic-bezier(0.3, 0, 1, 1)"
      }
    }
  },
  "button": {
    "$type": "dimension",
    "$description": "Character: the decisions a theme owns for its buttons. Metrics that every theme would answer the same way are spent in the CSS instead.",
    "weight": {
      "$value": "{font.weight.bold}"
    },
    "hover-lift-x": {
      "$value": "-2px",
      "$type": "dimension"
    },
    "hover-lift-y": {
      "$value": "-2px",
      "$type": "dimension"
    },
    "case": {
      "$value": "uppercase",
      "$type": "textTransform"
    },
    "tracking": {
      "$value": "0.05em",
      "$type": "dimension"
    },
    "border-width": {
      "$value": "2px",
      "$type": "dimension"
    },
    "shadow": {
      "$value": "4px 4px 0 0 oklch(14% 0 0)",
      "$type": "shadow"
    },
    "shadow-hover": {
      "$value": "6px 6px 0 0 oklch(14% 0 0)",
      "$type": "shadow"
    }
  },
  "$description": "Brutalist edges ported from sail. Hard borders, strong type, monochrome.",
  "border": {
    "$type": "dimension",
    "$description": "Stroke weight. Every control and surface reads this, so a theme changes its edge weight in one place.",
    "width": {
      "$value": "2px"
    }
  },
  "focus": {
    "$type": "dimension",
    "$description": "The focus ring, shared by every interactive element: buttons, links, fields, summaries and dialogs.",
    "width": {
      "$value": "2px"
    },
    "offset": {
      "$value": "2px"
    }
  }
}
