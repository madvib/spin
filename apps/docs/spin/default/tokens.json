{
  "$extends": "minimal",
  "modes": ["light", "dark"],
  "color": {
    "$type": "color",
    "primary": {
      "$value": "#171717",
      "$modes": {
        "dark": "#f5f5f5"
      }
    }
  },
  "element": {
    "h1": {
      "type": { "$type": "typography", "$value": "{font.style.display}" }
    },
    "p": {
      "type": { "$type": "typography", "$value": "{font.style.body}" }
    }
  },
  "button": {
    "radius": { "$type": "dimension", "$value": "{radius.md}" }
  }
}
