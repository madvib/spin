{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "types": ["vite/client", "bun-types"],
    "paths": {
      "@spinjs/components": ["../../packages/components/src/index.ts"],
      "@spinjs/components/*": ["../../packages/components/src/*"],
      "@spinjs/components/examples": [
        "../../packages/components/src/examples.ts"
      ],
      "@spinjs/kit": ["../../internal/kit/src/index.ts"],
      "@spinjs/preset": ["../../packages/spin/src/compiler/index.ts"],
      "@spinjs/preset/config": [
        "../../packages/spin/src/plugin/config.ts"
      ],
      "@spinjs/animation": ["../../packages/spin/src/animation/index.ts"],
      "@spinjs/spin/vite": ["../../packages/spin/src/plugin/plugin.ts"],
      "@spinjs/spin/preset": ["../../packages/spin/src/compiler/index.ts"],
      "@spinjs/spin/elements": [
        "../../packages/spin/src/compiler/elements.d.ts"
      ],
      "@spinjs/spin/theme": ["../../packages/spin/src/theme/index.ts"],
      "@spinjs/spin/theme/themes": [
        "../../packages/spin/src/theme/themes/index.ts"
      ],
      "@spinjs/spin/api": ["../../packages/spin/src/api/index.ts"],
      "@spinjs/spin/skill": ["../../packages/spin/src/skill/index.ts"],
      "@spinjs/spin/examples": ["../../packages/spin/src/examples/index.ts"],
      "@spinjs/spin/animation": ["../../packages/spin/src/animation/index.ts"],
      "@spinjs/spin/project": ["../../packages/spin/src/project/index.ts"],
      "@spin/check": ["../../internal/check/harness.ts"]
    }
  },
  "include": ["src", "tooling/markdown", "tooling/plugins", "tooling/sync-studio.ts", "vite.config.ts"]
}
