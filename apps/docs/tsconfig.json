{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "types": [
      "vite/client",
      "bun-types"
    ],
    "paths": {
      "@spinjs/components": [
        "../../packages/components/src/index.ts"
      ],
      "@spinjs/components/*": [
        "../../packages/components/src/*"
      ],
      "@spinjs/components/examples": [
        "../../packages/components/src/examples.ts"
      ],
      "@spinjs/kit": [
        "../../internal/kit/src/index.ts"
      ],
      "@spinjs/preset": [
        "../../packages/preset/src/index.ts"
      ],
      "@spinjs/dev/vite": [
        "../../packages/dev/src/plugin/plugin.ts"
      ],
      "@spinjs/dev/theme": [
        "../../packages/dev/src/theme.ts"
      ],
      "@spinjs/theme": [
        "../../packages/theme/src/index.ts"
      ],
      "@spinjs/dev/api": [
        "../../packages/dev/src/api/index.ts"
      ],
      "@spinjs/dev/skill": [
        "../../packages/dev/src/skill/index.ts"
      ],
      "@spinjs/dev/examples": [
        "../../packages/dev/src/examples/index.ts"
      ],
      "@spin/check": [
        "../../internal/check/harness.ts"
      ],
      "@spinjs/server": [
        "../../packages/server/src/index.ts"
      ],
      "@spinjs/server/project": [
        "../../packages/server/src/project/index.ts"
      ],
      "@spinjs/server/procedures": [
        "../../packages/server/src/procedures/index.ts"
      ],
      "@spinjs/server/daemon": [
        "../../packages/server/src/daemon.ts"
      ],
      "@spinjs/preset/elements": [
        "../../packages/preset/src/elements.d.ts"
      ],
      "@spinjs/build": [
        "../../packages/build/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "tooling/markdown",
    "tooling/plugins",
    "tooling/sync-studio.ts",
    "vite.config.ts"
  ]
}
