# Operational docs (git-ignored, will go stale)
.agents/

# Daemon discovery (written at start, removed on close)
spin-connection.json

# Harness run state (regenerated, never tracked)
.omo/

# Dependencies
node_modules/

# Build outputs
dist/
.output/

# Vite config caches (regenerated, never tracked)
*.timestamp-*.mjs

# Generated reference content (Uno scanner input, rebuilt by build-content.ts)
apps/reference/src/content/

# Visual check captures (regenerated by `bun run visual`)
apps/reference/visual/out/
apps/studio/visual/out/
apps/studio/visual/out-drawer/

# Vite dependency-optimizer caches (build junk; vanity-sized).
.vite/

# Local probe/exploration scripts; never part of the tree.
.scratchpad/

# The e2e suite writes a copied theme into the reference project
apps/reference/spin/e2e-copy.json

# Release tarballs (built by `bun run pack`, published, never tracked)
dist-tarballs/
*.tgz

# Local-only state
.local/
.omp/
coverage/

# Editor and OS noise
*.log
*.swp
*~
.DS_Store
