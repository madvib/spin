{
  "name": "@spin/project",
  "version": "0.1.0",
  "exports": {
    ".": "./src/index.ts",
    "./sync": "./src/sync.ts"
  },
  "imports": {
    "@spin/project": "./src/index.ts",
    "@spin/theme": "../theme/src/index.ts",
    "@spin/theme/themes": "../theme/src/themes/index.ts",
    "@spin/preset/config": "../preset/src/config.ts",
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-env --allow-sys src/ tests/",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable"
    ]
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-slow-types"
      ]
    }
  }
}
