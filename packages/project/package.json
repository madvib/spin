{
  "name": "@spinjs/project",
  "version": "0.1.0",
  "description": "The project: where it is, what it holds, what it declares.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madvib/spin.git"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./sync": {
      "types": "./src/sync.ts",
      "default": "./src/sync.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "@spinjs/preset": "workspace:*",
    "@spinjs/theme": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./sync": {
        "types": "./dist/sync.d.ts",
        "default": "./dist/sync.js"
      }
    }
  },
  "scripts": {
    "test": "bun test src/ tests/",
    "lint": "oxlint",
    "fmt": "biome format --write ."
  }
}
