{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "paths": {
      "@spin/components": [
        "../src/index.ts"
      ],
      "@spin/runtime": [
        "../../runtime/src/index.ts"
      ],
      "@spin/runtime/zag": [
        "../../runtime/src/adapter/index.ts"
      ],
      "@spin/preset": [
        "../../preset/src/index.ts"
      ],
      "@spin/theme": [
        "../../theme/src/index.ts"
      ],
      "@spin/theme/themes": [
        "../../theme/src/themes/index.ts"
      ]
    },
    "baseUrl": ".",
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
