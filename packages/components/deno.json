{
  "name": "@spin/components",
  "version": "0.1.0",
  "exports": {
    ".": "./src/index.ts",
    "./elements": "./src/elements.ts",
    "./async-list": "./src/spin-async-list/spin-async-list.html",
    "./carousel": "./src/spin-carousel/spin-carousel.html",
    "./cascade-select": "./src/spin-cascade-select/spin-cascade-select.html",
    "./combobox": "./src/spin-combobox/spin-combobox.html",
    "./dialog": "./src/spin-dialog/spin-dialog.html",
    "./editable": "./src/spin-editable/spin-editable.html",
    "./menu": "./src/spin-menu/spin-menu.html",
    "./number-input": "./src/spin-number-input/spin-number-input.html",
    "./pin-input": "./src/spin-pin-input/spin-pin-input.html",
    "./tags-input": "./src/spin-tags-input/spin-tags-input.html",
    "./timer": "./src/spin-timer/spin-timer.html",
    "./toast": "./src/spin-toast/spin-toast.html",
    "./tree-view": "./src/spin-tree-view/spin-tree-view.html"
  },
  "imports": {
    "@spin/components": "./src/index.ts",
    "@spin/runtime": "../runtime/src/index.ts",
    "@spin/preset": "../preset/src/index.ts",
    "@spin/theme": "../theme/src/index.ts",
    "@spin/theme/themes": "../theme/src/themes/index.ts",
    "@unocss/core": "npm:@unocss/core@^66.10.5",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@spin/runtime/load": "../runtime/src/directives/load.ts",
    "@spin/runtime/fsm": "../runtime/src/machine/fsm/machine.ts",
    "@spin/runtime/actions": "../runtime/src/actions/index.ts",
    "@spin/hooks": "../../hooks/src/index.ts",
    "@spin/hooks/solid": "../../hooks/src/solid.ts",
    "@spin/hooks/react": "../../hooks/src/react.ts"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-import src/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "e2e:carousel": "deno test --allow-read --allow-net --allow-run --allow-env --allow-sys --allow-write=/tmp --allow-import --min-dep-age=0 tests/carousel.e2e.ts",
    "e2e:menu": "deno run --allow-read --allow-net --allow-run --allow-env --allow-sys --allow-write=/tmp --allow-import tests/menu.e2e.ts",
    "e2e:cascade": "deno test --allow-read --allow-net --allow-run --allow-env --allow-sys --allow-write=/tmp --allow-import --min-dep-age=0 tests/cascade.e2e.ts",
    "e2e:tags": "deno test --allow-read --allow-net --allow-run --allow-env --allow-sys --allow-write=/tmp --allow-import --min-dep-age=0 tests/tags.e2e.ts",
    "e2e:number-input": "deno test --allow-read --allow-net --allow-run --allow-env --allow-sys --allow-write=/tmp --allow-import --min-dep-age=0 tests/number-input.e2e.ts",
    "e2e:timer": "deno test --allow-read --allow-net --allow-run --allow-env --allow-sys --allow-write=/tmp --allow-import --min-dep-age=0 tests/timer.e2e.ts",
    "e2e:pin-input": "deno test --allow-read --allow-net --allow-run --allow-env --allow-sys --allow-write=/tmp --allow-import --min-dep-age=0 tests/pin-input.e2e.ts",
    "e2e:async-list": "deno test --allow-read --allow-net --allow-run --allow-env --allow-sys --allow-write=/tmp --allow-import --min-dep-age=0 tests/async-list.e2e.ts",
    "e2e:combobox": "deno test --allow-read --allow-net --allow-run --allow-env --allow-sys --allow-write=/tmp --allow-import --min-dep-age=0 tests/combobox.e2e.ts",
    "e2e:editable": "deno test --allow-read --allow-net --allow-run --allow-env --allow-sys --allow-write=/tmp --allow-import --min-dep-age=0 tests/editable.e2e.ts",
    "e2e:toast": "deno test --allow-read --allow-net --allow-run --allow-env --allow-sys --allow-write=/tmp --allow-import --min-dep-age=0 tests/toast.e2e.ts"
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable"
    ]
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-slow-types"
