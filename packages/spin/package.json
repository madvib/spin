{
  "name": "@spinjs/spin",
  "version": "0.1.0-preview.6",
  "description": "The spin toolchain: themes, the Uno preset and plugin, project operations, diagnostics, the daemon, and the agent server.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madvib/spin.git"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/plugin/plugin.ts",
      "default": "./src/plugin/plugin.ts"
    },
    "./package.json": "./package.json",
    "./vite": {
      "types": "./src/plugin/plugin.ts",
      "default": "./src/plugin/plugin.ts"
    },
    "./compositions": {
      "types": "./src/compositions.ts",
      "default": "./src/compositions.ts"
    },
    "./cli": {
      "types": "./src/cli/main.ts",
      "default": "./src/cli/main.ts"
    },
    "./mcp": {
      "types": "./src/mcp/index.ts",
      "default": "./src/mcp/index.ts"
    },
    "./preset/plugin": {
      "types": "./src/plugin/plugin.ts",
      "default": "./src/plugin/plugin.ts"
    },
    "./plugin": {
      "types": "./src/plugin/index.ts",
      "default": "./src/plugin/index.ts"
    },
    "./api": {
      "types": "./src/api/index.ts",
      "default": "./src/api/index.ts"
    },
    "./api/client": {
      "types": "./src/api/client.ts",
      "default": "./src/api/client.ts"
    },
    "./mcp/main": {
      "types": "./src/mcp/main.ts",
      "default": "./src/mcp/main.ts"
    },
    "./skill": {
      "types": "./src/skill/index.ts",
      "default": "./src/skill/index.ts"
    },
    "./skill/authoring": {
      "types": "./src/skill/authoring.ts",
      "default": "./src/skill/authoring.ts"
    },
    "./lsp": {
      "types": "./src/lsp/index.ts",
      "default": "./src/lsp/index.ts"
    },
    "./examples": {
      "types": "./src/examples/index.ts",
      "default": "./src/examples/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "skill"
  ],
  "bin": {
    "spin": "./dist/cli/main.js"
  },
  "dependencies": {
    "@iconify-json/carbon": "^1.2.28",
    "@iconify-json/lucide": "^1.2.0",
    "@iconify-json/material-symbols": "^1.2.95",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/tabler": "^1.2.42",
    "@modelcontextprotocol/server": "2.4.0",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/server": "catalog:",
    "@spinjs/build": "workspace:*",
    "@spinjs/diagnostics": "workspace:*",
    "@spinjs/preset": "workspace:*",
    "@spinjs/server": "workspace:*",
    "@spinjs/theme": "workspace:*",
    "@unocss/core": "66.10.5",
    "@unocss/preset-icons": "66.10.5",
    "hono": "^4.13.13",
    "unplugin": "^3.4.0",
    "valibot": "catalog:",
    "zod": "^4.2.0"
  },
  "peerDependencies": {
    "@spinjs/components": "workspace:*",
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/react": "^19.0.0",
    "@typescript-eslint/parser": "8.71.0",
    "@unocss/core": "66.10.5",
    "@unocss/preset-attributify": "66.10.5",
    "@unocss/preset-tagify": "66.10.5",
    "eslint": "^9.39.4",
    "magic-string": "^1.4.1",
    "solid-js": "^1.9.3"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/plugin/plugin.d.ts",
        "default": "./dist/plugin/plugin.js"
      },
      "./package.json": {
        "default": "./package.json"
      },
      "./vite": {
        "types": "./dist/plugin/plugin.d.ts",
        "default": "./dist/plugin/plugin.js"
      },
      "./compositions": {
        "types": "./dist/compositions.d.ts",
        "default": "./dist/compositions.js"
      },
      "./cli": {
        "types": "./dist/cli/main.d.ts",
        "default": "./dist/cli/main.js"
      },
      "./mcp": {
        "types": "./dist/mcp/index.d.ts",
        "default": "./dist/mcp/index.js"
      },
      "./preset/plugin": {
        "types": "./dist/plugin/plugin.d.ts",
        "default": "./dist/plugin/plugin.js"
      },
      "./plugin": {
        "types": "./dist/plugin/index.d.ts",
        "default": "./dist/plugin/index.js"
      },
      "./api": {
        "types": "./dist/api/index.d.ts",
        "default": "./dist/api/index.js"
      },
      "./api/client": {
        "types": "./dist/api/client.d.ts",
        "default": "./dist/api/client.js"
      },
      "./mcp/main": {
        "types": "./dist/mcp/main.d.ts",
        "default": "./dist/mcp/main.js"
      },
      "./skill": {
        "types": "./dist/skill/index.d.ts",
        "default": "./dist/skill/index.js"
      },
      "./skill/authoring": {
        "types": "./dist/skill/authoring.d.ts",
        "default": "./dist/skill/authoring.js"
      },
      "./lsp": {
        "types": "./dist/lsp/index.d.ts",
        "default": "./dist/lsp/index.js"
      },
      "./examples": {
        "types": "./dist/examples/index.d.ts",
        "default": "./dist/examples/index.js"
      }
    }
  },
  "scripts": {
    "test": "bun test src/ tests/",
    "lint": "bunx oxlint@1.85.0 --config ../../.oxlintrc.json src/",
    "fmt": "bunx oxfmt@0.78.0 --write .",
    "codegen": "cd ../preset && bun run codegen",
    "skill": "bun -e \"import { readFile, writeFile } from 'node:fs/promises'; import { renderAuthoringSkill } from './src/skill/authoring.ts'; await writeFile('./skill/spin-type.md', renderAuthoringSkill(await readFile('./skill/spin-type.md', 'utf8'))); console.log('wrote skill/spin-type.md');\"",
    "skill:all": "bun -e \"import { readFile, writeFile } from 'node:fs/promises'; import { renderSkill } from './src/skill/index.ts'; import { renderAuthoringSkill } from './src/skill/authoring.ts'; await writeFile('./skill/SKILL.md', renderSkill(await readFile('./skill/SKILL.md', 'utf8'))); await writeFile('./skill/spin-type.md', renderAuthoringSkill(await readFile('./skill/spin-type.md', 'utf8'))); console.log('wrote skill/SKILL.md + skill/spin-type.md');\""
  }
}
