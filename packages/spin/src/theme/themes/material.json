{
  "$extends": "base",
  "$extensions": {
    "spin": {
      "fonts": [
        {
          "family": "Outfit",
          "src": "url(https://cdn.jsdelivr.net/fontsource/fonts/outfit:vf@latest/latin-wght-normal.woff2) format(\"woff2\")",
          "weight": "300 800",
          "style": "normal",
          "display": "swap"
        },
        {
          "family": "Plus Jakarta Sans",
          "src": "url(https://cdn.jsdelivr.net/fontsource/fonts/plus-jakarta-sans:vf@latest/latin-wght-normal.woff2) format(\"woff2\")",
          "weight": "300 800",
          "style": "normal",
          "display": "swap"
        },
        {
          "family": "JetBrains Mono",
          "src": "url(https://cdn.jsdelivr.net/fontsource/fonts/jetbrains-mono:vf@latest/latin-wght-normal.woff2) format(\"woff2\")",
          "weight": "100 800",
          "style": "normal",
          "display": "swap"
        }
      ]
    }
  },
  "color": {
    "$type": "color",
    "$description": "The light palette. Derived roles (surface, text, border) are references into the neutral ramp, so re-tinting the ramp re-tints every surface with it.",
    "primary": {
      "$value": "#4f46e5",
      "$modes": {
        "dark": "#a5b4fc"
      }
    },
    "secondary": {
      "$value": "#e0e7ff",
      "$modes": {
        "dark": "#282442"
      }
    },
    "accent": {
      "$value": "#be185d",
      "$modes": {
        "dark": "#f472b6"
      }
    },
    "neutral": {
      "50": {
        "$value": "#f5f4fc",
        "$modes": {
          "dark": "#0f0e1a"
        }
      },
      "100": {
        "$value": "#eceaf9",
        "$modes": {
          "dark": "#171526"
        }
      },
      "200": {
        "$value": "#dddaf2",
        "$modes": {
          "dark": "#221f36"
        }
      },
      "300": {
        "$value": "#c5c0e6",
        "$modes": {
          "dark": "#312d4b"
        }
      },
      "400": {
        "$value": "#9c95c9",
        "$modes": {
          "dark": "#49446b"
        }
      },
      "500": {
        "$value": "#6f689c",
        "$modes": {
          "dark": "#6e6894"
        }
      },
      "600": {
        "$value": "#514b78",
        "$modes": {
          "dark": "#9c96c2"
        }
      },
      "700": {
        "$value": "#383359",
        "$modes": {
          "dark": "#c2bde3"
        }
      },
      "800": {
        "$value": "#221e3d",
        "$modes": {
          "dark": "#e0ddf5"
        }
      },
      "900": {
        "$value": "#110e24",
        "$modes": {
          "dark": "#f4f3fc"
        }
      },
      "$description": "The grey ramp, 50 (lightest) through 900 (darkest)."
    },
    "semantic": {
      "$description": "Status colors. Named by meaning, never by hue.",
      "success": {
        "$value": "#26753e",
        "$modes": {
          "dark": "#72cf88"
        }
      },
      "warning": {
        "$value": "#886108",
        "$modes": {
          "dark": "#eac26b"
        }
      },
      "error": {
        "$value": "#a6312b",
        "$modes": {
          "dark": "#f38277"
        }
      },
      "info": {
        "$value": "#0e629a",
        "$modes": {
          "dark": "#6dbbe8"
        }
      }
    },
    "surface": {
      "$value": "{color.neutral.50}"
    },
    "surface-sunken": {
      "$value": "{color.neutral.100}"
    },
    "surface-raised": {
      "$value": "#ffffff",
      "$modes": {
        "dark": "#1c192e"
      }
    },
    "text": {
      "$value": "{color.neutral.900}",
      "$description": "Default body text.",
      "$modes": {
        "dark": "#f3f5f8"
      }
    },
    "text-muted": {
      "$value": "{color.neutral.600}",
      "$description": "Secondary text: captions, helper copy, placeholders.",
      "$modes": {
        "dark": "#999fa7"
      }
    },
    "border": {
      "$value": "{color.neutral.200}",
      "$description": "Default hairline and divider.",
      "$modes": {
        "dark": "#1d242f"
      }
    },
    "scrim": {
      "$value": "rgb(15 19 30 / 45%)",
      "$description": "What dims the page behind a modal. A theme closes its dialogs over its own ink, not a neutral black.",
      "$modes": {
        "dark": "rgb(15 19 30 / 60%)"
      }
    },
    "on-primary": {
      "$value": "#ffffff",
      "$modes": {
        "dark": "#141136"
      }
    },
    "focus-ring": {
      "$value": "#4f46e5",
      "$modes": {
        "dark": "#a5b4fc"
      }
    },
    "link": {
      "$value": "#4338ca",
      "$modes": {
        "dark": "#a5b4fc"
      }
    },
    "on-secondary": {
      "$value": "#1e1b4b",
      "$modes": {
        "dark": "#e0e7ff"
      }
    },
    "on-accent": {
      "$value": "#ffffff",
      "$modes": {
        "dark": "#290615"
      }
    },
    "selected": {
      "$type": "color",
      "$value": "{color.text}"
    },
    "on-selected": {
      "$type": "color",
      "$value": "{color.surface}"
    },
    "on-semantic-success": {
      "$type": "color",
      "$value": "#ffffff",
      "$modes": {
        "dark": "#111923"
      }
    },
    "on-semantic-warning": {
      "$type": "color",
      "$value": "#ffffff",
      "$modes": {
        "dark": "#111923"
      }
    },
    "field": {
      "$value": "#eceaf9",
      "$modes": {
        "dark": "#171526"
      }
    },
    "border-strong": {
      "$type": "color",
      "$value": "#a6afbb",
      "$description": "A control's own edge: stronger than `border`, which divides content. A field has to read as a field at a glance.",
      "$modes": {
        "dark": "#434b57"
      }
    },
    "on-semantic-error": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "Text on the matching fill. A fill with no foreground cannot be read, which is what this token prevents.",
      "$modes": {
        "dark": "#111923"
      }
    },
    "on-danger": {
      "$type": "color",
      "$value": "{color.on-semantic-error}",
      "$description": "The legacy name for the ink on the error fill. It points at `color.on-semantic-error` — the role the contract requires, the floor is measured on, and the danger button and the danger badge wear — so the two names can never disagree."
    },
    "on-semantic-info": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "Text on the matching fill. A fill with no foreground cannot be read, which is what this token prevents.",
      "$modes": {
        "dark": "#111923"
      }
    },
    "disabled": {
      "$value": "{color.neutral.200}",
      "$description": "The fill a dead control wears: the ramp one step off the page, so a control that cannot be pressed still reads as a control rather than as a hole in the layout.",
      "$modes": {
        "dark": "{color.neutral.200}"
      }
    },
    "on-disabled": {
      "$type": "color",
      "$value": "{color.neutral.600}",
      "$description": "The ink on that fill. Dimming the control instead would dim this with it, which is how a dead button becomes an unreadable one.",
      "$modes": {
        "dark": "{color.neutral.600}"
      }
    },
    "primary-hover": {
      "$value": "#4338ca",
      "$modes": {
        "dark": "#c7d2fe"
      }
    },
    "primary-active": {
      "$value": "#3730a3",
      "$modes": {
        "dark": "#818cf8"
      }
    },
    "secondary-hover": {
      "$value": "#c7d2fe",
      "$modes": {
        "dark": "#342f54"
      }
    },
    "secondary-active": {
      "$value": "#a5b4fc",
      "$modes": {
        "dark": "#403a66"
      }
    },
    "link-hover": {
      "$value": "#312e81",
      "$modes": {
        "dark": "#c7d2fe"
      }
    },
    "link-visited": {
      "$value": "#6d28d9",
      "$modes": {
        "dark": "#c4b5fd"
      }
    }
  },
  "spacing": {
    "1": {
      "$value": "0.281rem"
    },
    "2": {
      "$value": "0.563rem"
    },
    "3": {
      "$value": "0.844rem"
    },
    "4": {
      "$value": "1.125rem"
    },
    "5": {
      "$value": "1.406rem"
    },
    "6": {
      "$value": "1.688rem"
    },
    "7": {
      "$value": "1.969rem"
    },
    "8": {
      "$value": "2.25rem"
    },
    "10": {
      "$value": "2.813rem"
    },
    "12": {
      "$value": "3.375rem"
    },
    "14": {
      "$value": "3.938rem"
    },
    "16": {
      "$value": "4.5rem"
    },
    "20": {
      "$value": "5.625rem"
    },
    "24": {
      "$value": "6.75rem"
    },
    "36": {
      "$value": "10.125rem"
    },
    "40": {
      "$value": "11.25rem"
    },
    "56": {
      "$value": "15.75rem"
    },
    "60": {
      "$value": "16.875rem"
    },
    "64": {
      "$value": "18rem"
    }
  },
  "font": {
    "$description": "Typography: which face, how large, how heavy, and how open the tracking sits.",
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": "Plus Jakarta Sans, ui-sans-serif, system-ui, sans-serif",
        "$description": "Body and UI text."
      },
      "heading": {
        "$value": "Outfit, Plus Jakarta Sans, sans-serif",
        "$description": "The display face. Silk answers with the sans; a theme with a display voice states its own."
      },
      "body": {
        "$value": "{font.family.sans}",
        "$description": "The body face. Distinct from `sans` only when a theme wants the two to differ."
      },
      "serif": {
        "$value": "ui-serif, Georgia, Cambria, serif",
        "$description": "Long-form editorial text."
      },
      "mono": {
        "$value": "ui-monospace, SFMono-Regular, Menlo, monospace",
        "$description": "Code, identifiers, tabular figures."
      },
      "brand": {
        "$type": "fontFamily",
        "$value": "Bricolage Grotesque, Space Grotesk, ui-sans-serif, system-ui, sans-serif",
        "$description": "The logotype face — one brand, every starter."
      }
    },
    "style": {
      "display": {
        "$type": "typography",
        "$description": "The display voice: the largest statement a page makes.",
        "$value": {
          "family": "{font.family.sans}",
          "size": "{font.size.3xl}",
          "weight": "{font.weight.bold}",
          "tracking": "{font.tracking.tight}",
          "leading": "{font.leading.tight}"
        }
      },
      "title": {
        "$type": "typography",
        "$description": "The title voice: a section head at the medium weight, soft on purpose.",
        "$value": {
          "family": "{font.family.sans}",
          "size": "{font.size.2xl}",
          "weight": "{font.weight.medium}",
          "tracking": "{font.tracking.normal}",
          "leading": "{font.leading.snug}"
        }
      },
      "heading": {
        "$type": "typography",
        "$description": "The heading voice: a subsection head inside a section.",
        "$value": {
          "family": "{font.family.sans}",
          "size": "{font.size.xl}",
          "weight": "{font.weight.semibold}",
          "tracking": "{font.tracking.normal}",
          "leading": "{font.leading.snug}"
        }
      },
      "subtitle": {
        "$type": "typography",
        "$description": "The subtitle voice: the sentence under a heading that frames what follows.",
        "$value": {
          "family": "{font.family.sans}",
          "size": "{font.size.lg}",
          "weight": "{font.weight.medium}",
          "tracking": "{font.tracking.normal}",
          "leading": "{font.leading.snug}"
        }
      },
      "lead": {
        "$type": "typography",
        "$description": "The lead voice: the sentence that introduces what follows.",
        "$value": {
          "family": "{font.family.sans}",
          "size": "{font.size.lg}",
          "weight": "{font.weight.regular}",
          "tracking": "{font.tracking.normal}",
          "leading": "{font.leading.relaxed}"
        }
      },
      "body": {
        "$type": "typography",
        "$description": "The body voice: the default reading text.",
        "$value": {
          "family": "{font.family.sans}",
          "size": "{font.size.md}",
          "weight": "{font.weight.regular}",
          "tracking": "{font.tracking.normal}",
          "leading": "{font.leading.relaxed}"
        }
      },
      "quote": {
        "$type": "typography",
        "$description": "The quotation voice: long-form editorial text set apart.",
        "$value": {
          "family": "{font.family.serif}",
          "size": "{font.size.md}",
          "weight": "{font.weight.regular}",
          "tracking": "{font.tracking.normal}",
          "leading": "{font.leading.relaxed}"
        }
      },
      "code": {
        "$type": "typography",
        "$description": "The code voice: machine text at relaxed leading beside soft prose.",
        "$value": {
          "family": "{font.family.mono}",
          "size": "{font.size.sm}",
          "weight": "{font.weight.regular}",
          "tracking": "{font.tracking.normal}",
          "leading": "{font.leading.relaxed}"
        }
      },
      "label": {
        "$type": "typography",
        "$description": "The label voice: the name on a control or a field.",
        "$value": {
          "family": "{font.family.sans}",
          "size": "{font.size.sm}",
          "weight": "{font.weight.medium}",
          "tracking": "{font.tracking.wide}",
          "leading": "{font.leading.snug}"
        }
      },
      "caption": {
        "$type": "typography",
        "$description": "The caption voice: small print under a figure or a table.",
        "$value": {
          "family": "{font.family.sans}",
          "size": "{font.size.xs}",
          "weight": "{font.weight.regular}",
          "tracking": "{font.tracking.normal}",
          "leading": "{font.leading.snug}"
        }
      },
      "overline": {
        "$type": "typography",
        "$description": "The overline voice: an eyebrow or category mark above copy.",
        "$value": {
          "family": "{font.family.sans}",
          "size": "{font.size.xs}",
          "weight": "{font.weight.semibold}",
          "tracking": "{font.tracking.wider}",
          "leading": "{font.leading.snug}"
        }
      },
      "stat": {
        "$type": "typography",
        "$description": "The stat voice: the number a figure shows, set in the product sans.",
        "$value": {
          "family": "{font.family.sans}",
          "size": "{font.size.2xl}",
          "weight": "{font.weight.semibold}",
          "tracking": "{font.tracking.normal}",
          "leading": "{font.leading.tight}"
        }
      },
      "badge": {
        "$type": "typography",
        "$description": "The badge voice: the word on a pill, set small enough to sit inside one.",
        "$value": {
          "family": "{font.family.sans}",
          "size": "{font.size.2xs}",
          "weight": "{font.weight.medium}",
          "tracking": "{font.tracking.wide}",
          "leading": "{font.leading.none}"
        }
      },
      "body-strong": {
        "$type": "typography",
        "$description": "The strong voice: body copy with emphasis.",
        "$value": {
          "family": "{font.family.sans}",
          "size": "{font.size.md}",
          "weight": "{font.weight.semibold}",
          "tracking": "{font.tracking.normal}",
          "leading": "{font.leading.relaxed}"
        }
      },
      "caption-strong": {
        "$type": "typography",
        "$description": "The figure-caption voice: a caption that names its figure.",
        "$value": {
          "family": "{font.family.sans}",
          "size": "{font.size.xs}",
          "weight": "{font.weight.semibold}",
          "tracking": "{font.tracking.wide}",
          "leading": "{font.leading.snug}"
        }
      },
      "card-title": {
        "$type": "typography",
        "$description": "The card-title voice: the name on a card, set to be found inside a surface.",
        "$value": {
          "family": "{font.family.sans}",
          "size": "{font.size.lg}",
          "weight": "{font.weight.semibold}",
          "tracking": "{font.tracking.normal}",
          "leading": "{font.leading.snug}"
        }
      }
    }
  },
  "radius": {
    "md": {
      "$value": "0.875rem"
    },
    "lg": {
      "$value": "1.25rem"
    }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Elevation, as CSS box-shadow values.",
    "sm": {
      "$value": "0 1px 2px -1px rgb(15 19 30 / 0.08), 0 1px 3px 0 rgb(15 19 30 / 0.06)"
    },
    "md": {
      "$value": "0 4px 8px -2px rgb(15 19 30 / 0.10), 0 2px 4px -2px rgb(15 19 30 / 0.06)"
    },
    "lg": {
      "$value": "0 16px 40px -8px rgb(15 19 30 / 0.16), 0 4px 12px -4px rgb(15 19 30 / 0.08)"
    }
  },
  "button": {
    "shadow": {
      "$type": "shadow",
      "$description": "The resting elevation. A control with no shadow sits on the page rather than in it.",
      "$value": "none"
    },
    "shadow-hover": {
      "$type": "shadow",
      "$description": "The hovered elevation. The lift is the hover feedback; without it a pointer tells the reader nothing.",
      "$value": "0 4px 14px -2px rgb(79 70 229 / 0.22)"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.full}"
    }
  },
  "badge": {},
  "$description": "Tonal & pill: indigo-tinted surface containers that separate hierarchy by tone rather than heavy borders, paired with 9999px pill controls and 20px cards.",
  "card": {
    "padding": {
      "$type": "dimension",
      "$value": "{spacing.5}",
      "$description": "The air inside the card, between its parts and around its edge."
    },
    "elevation": {
      "$type": "shadow",
      "$value": "0 2px 10px -2px rgb(49 46 129 / 0.07)",
      "$description": "The theme's resting step: a card sits on the page rather than floating above it."
    }
  },
  "alert": {},
  "field": {}
}
