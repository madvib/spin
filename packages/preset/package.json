{
  "name": "@spinjs/preset",
  "version": "0.2.0-alpha.1",
  "description": "The Uno renderer: preset, vocabulary, primitives, and the checker's engine answers.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madvib/spin.git"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./elements": {
      "types": "./src/elements.d.ts"
    },
    "./elements/react": {
      "types": "./src/elements-react.d.ts"
    },
    "./elements/solid": {
      "types": "./src/elements-solid.d.ts"
    },
    "./elements/svelte": {
      "types": "./src/elements-svelte.d.ts"
    },
    "./elements/vue": {
      "types": "./src/elements-vue.d.ts"
    },
    "./css": {
      "types": "./src/utils/css.ts",
      "default": "./src/utils/css.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@spinjs/theme": "workspace:*",
    "@orpc/contract": "catalog:",
    "@orpc/server": "catalog:",
    "@unocss/core": "66.10.5",
    "@unocss/preset-wind4": "66.10.5",
    "@unocss/transformer-directives": "66.10.5",
    "@unocss/transformer-variant-group": "66.10.5",
    "valibot": "catalog:"
  },
  "scripts": {
    "test": "bun test src/",
    "lint": "bunx oxlint@1.85.0 --config ../../.oxlintrc.json src/",
    "fmt": "bunx oxfmt@0.78.0 --write .",
    "codegen": "bun run src/rules/primitives/derive.ts && bunx oxfmt@0.78.0 --write src/rules/primitives/manifest.ts"
  },
  "devDependencies": {
    "@spinjs/server": "workspace:*",
    "@unocss/preset-attributify": "66.10.5",
    "magic-string": "^1.4.1",
    "solid-js": "^1.9.3"
  }
}
