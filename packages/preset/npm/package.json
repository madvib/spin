{
  "name": "@spin/preset",
  "version": "0.1.1",
  "description": "The UnoCSS preset over @spin/theme: the utilities, the element library, the plugin.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madvib/spin.git"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@orpc/contract": "1",
    "@orpc/server": "1",
    "@unocss/core": "^66.10.5",
    "@unocss/preset-wind4": "^66.10.5",
    "@unocss/transformer-directives": "^66.10.5",
    "@unocss/transformer-variant-group": "^66.10.5",
    "unplugin": "^3.4.0",
    "valibot": "1"
  },
  "peerDependencies": {
    "@spin/animation": "^0.1.0",
    "@spin/theme": "^0.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
