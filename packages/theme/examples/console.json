{
  "$extensions": {
    "spin": {
      "id": "console",
      "modes": [
        "dark"
      ]
    }
  },
  "color": {
    "$type": "color",
    "surface": {
      "$value": "oklch(16% 0.01 220)",
      "$type": "color"
    },
    "surface-raised": {
      "$value": "oklch(16% 0.01 220)",
      "$type": "color"
    },
    "text": {
      "$value": "oklch(92% 0.06 145)",
      "$type": "color"
    },
    "text-muted": {
      "$value": "oklch(62% 0.05 145)",
      "$type": "color"
    },
    "border": {
      "$value": "oklch(30% 0.04 145 / 0.4)",
      "$type": "color"
    },
    "primary": {
      "$value": "oklch(78% 0.2 145)",
      "$type": "color"
    },
    "accent": {
      "$value": "oklch(78% 0.16 195)",
      "$type": "color"
    },
    "secondary": {
      "$value": "oklch(20% 0.012 220)",
      "$type": "color"
    },
    "semantic": {
      "$description": "Status colors. Named by meaning, never by hue.",
      "success": {
        "$value": "oklch(78% 0.2 145)",
        "$type": "color"
      },
      "warning": {
        "$value": "oklch(85% 0.18 90)",
        "$type": "color"
      },
      "info": {
        "$value": "oklch(78% 0.16 195)",
        "$type": "color"
      },
      "error": {
        "$value": "oklch(70% 0.22 25)",
        "$description": "Error status, same value as danger.",
        "$type": "color"
      },
      "danger": {
        "$value": "oklch(70% 0.22 25)",
        "$type": "color"
      }
    },
    "on-primary": {
      "$value": "oklch(16% 0.01 220)",
      "$type": "color"
    },
    "on-danger": {
      "$value": "oklch(16% 0.01 220)",
      "$type": "color"
    },
    "focus-ring": {
      "$value": "{color.primary}"
    },
    "link": {
      "$value": "{color.accent}",
      "$description": "A second hue for links; the primary is reserved for the phosphor fill."
    }
  },
  "spacing": {
    "0": {
      "$value": "0"
    },
    "1": {
      "$value": "0.25rem"
    },
    "2": {
      "$value": "0.5rem"
    },
    "4": {
      "$value": "1rem"
    },
    "8": {
      "$value": "2rem"
    },
    "16": {
      "$value": "4rem"
    },
    "$type": "dimension",
    "$description": "The spacing scale. Every gap, pad and inset is one of these steps."
  },
  "font": {
    "$description": "Typography: which face, how large, how heavy.",
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": "\"JetBrains Mono Variable\", \"JetBrains Mono\", ui-monospace, \"SFMono-Regular\", Menlo, Consolas, monospace",
        "$type": "fontFamily"
      },
      "serif": {
        "$value": "ui-serif, Georgia, Cambria, serif",
        "$description": "Long-form editorial text."
      },
      "mono": {
        "$value": "\"JetBrains Mono Variable\", \"JetBrains Mono\", ui-monospace, \"SFMono-Regular\", Menlo, Consolas, monospace",
        "$type": "fontFamily"
      }
    },
    "size": {
      "$type": "dimension",
      "xs": {
        "$value": "0.75rem"
      },
      "sm": {
        "$value": "0.875rem"
      },
      "md": {
        "$value": "1rem"
      },
      "lg": {
        "$value": "1.125rem"
      },
      "xl": {
        "$value": "1.25rem"
      },
      "2xl": {
        "$value": "1.5rem"
      },
      "3xl": {
        "$value": "1.875rem"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Corner rounding, from square to fully round.",
    "none": {
      "$value": "0"
    },
    "sm": {
      "$value": "2px",
      "$type": "dimension"
    },
    "md": {
      "$value": "2px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "3px",
      "$type": "dimension"
    },
    "full": {
      "$value": "9999px"
    },
    "xl": {
      "$value": "4px",
      "$type": "dimension"
    }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Elevation, as CSS box-shadow values.",
    "sm": {
      "$value": "0 1px 2px oklch(0 0 0 / 50%), 0 0 0 1px oklch(0.78 0.20 145 / 12%)",
      "$type": "shadow"
    },
    "md": {
      "$value": "0 0 0 1px oklch(0.78 0.20 145 / 30%), 0 4px 0 -1px oklch(0 0 0 / 60%)",
      "$type": "shadow"
    },
    "lg": {
      "$value": "0 0 0 1px oklch(0.78 0.20 145 / 40%), 0 8px 0 -2px oklch(0 0 0 / 70%)",
      "$type": "shadow"
    },
    "xs": {
      "$value": "0 0 0 1px oklch(0.78 0.20 145 / 10%)",
      "$type": "shadow"
    },
    "xl": {
      "$value": "0 24px 64px oklch(0 0 0 / 70%)",
      "$type": "shadow"
    },
    "card-rest": {
      "$value": "0 0 0 1px oklch(0.78 0.20 145 / 30%)",
      "$type": "shadow"
    },
    "hover": {
      "$value": "0 0 0 1px oklch(0.78 0.20 145 / 60%), 0 0 0 3px oklch(0.78 0.20 145 / 10%)",
      "$type": "shadow"
    },
    "sticky": {
      "$value": "0 1px 0 oklch(0.78 0.20 145 / 24%)",
      "$type": "shadow"
    },
    "accent": {
      "$value": "0 0 0 2px oklch(0.78 0.20 145 / 55%), 0 0 18px oklch(0.78 0.20 145 / 18%)",
      "$type": "shadow"
    },
    "edge-top": {
      "$value": "0 -1px 0 oklch(0.78 0.20 145 / 30%)",
      "$type": "shadow"
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "$description": "Viewport widths where layout steps change.",
    "sm": {
      "$value": "40rem"
    },
    "md": {
      "$value": "48rem"
    },
    "lg": {
      "$value": "64rem"
    },
    "xl": {
      "$value": "80rem"
    }
  },
  "z-index": {
    "$type": "number",
    "$description": "Stacking order. Layer, never a magic number at the call site.",
    "base": {
      "$value": 0
    },
    "dropdown": {
      "$value": 1000
    },
    "modal": {
      "$value": 2000
    },
    "toast": {
      "$value": 3000
    }
  },
  "motion": {
    "$description": "How things move and how long it takes.",
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "150ms"
      },
      "base": {
        "$value": "250ms"
      },
      "slow": {
        "$value": "400ms"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "linear": {
        "$value": "linear"
      },
      "standard": {
        "$value": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "decelerate": {
        "$value": "cubic-bezier(0, 0, 0, 1)"
      },
      "accelerate": {
        "$value": "cubic-bezier(0.3, 0, 1, 1)"
      }
    }
  },
  "$description": "Terminal phosphor, ported from sail. Dark-only green-on-black.",
  "button": {
    "$type": "dimension",
    "$description": "Character: the decisions a theme owns for its buttons. Metrics that every theme would answer the same way are spent in the CSS instead.",
    "weight": {
      "$value": 700,
      "$type": "fontWeight"
    },
    "case": {
      "$value": "uppercase",
      "$type": "textTransform"
    },
    "tracking": {
      "$value": "0.1em",
      "$type": "dimension"
    },
    "shadow": {
      "$value": "none",
      "$type": "shadow"
    },
    "shadow-hover": {
      "$value": "none",
      "$type": "shadow"
    }
  },
  "border": {
    "$type": "dimension",
    "$description": "Stroke weight. Every control and surface reads this, so a theme changes its edge weight in one place.",
    "width": {
      "$value": "1px"
    }
  },
  "focus": {
    "$type": "dimension",
    "$description": "The focus ring, shared by every interactive element: buttons, links, fields, summaries and dialogs.",
    "width": {
      "$value": "1px"
    },
    "offset": {
      "$value": "1px"
    }
  }
}
