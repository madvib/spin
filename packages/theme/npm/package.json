{
  "name": "@spin/theme",
  "version": "0.1.0",
  "description": "DTCG JSON in, token trees out — the theme pipeline behind spin.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madvib/spin.git"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./base": {
      "types": "./dist/base/index.d.ts",
      "default": "./dist/base/index.js"
    },
    "./themes": {
      "types": "./dist/themes/index.d.ts",
      "default": "./dist/themes/index.js"
    },
    "./theme-types": {
      "types": "./dist/theme-types.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@orpc/contract": "1",
    "@orpc/server": "1",
    "@sinclair/typebox": "0.34",
    "valibot": "1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
