{
  "$extends": "base",
  "$extensions": {
    "spin": {
      "fonts": [
        {
          "family": "Inter",
          "src": "url(https://cdn.jsdelivr.net/fontsource/fonts/inter:vf@latest/latin-wght-normal.woff2) format(\"woff2\")",
          "weight": "100 900",
          "style": "normal",
          "display": "swap"
        },
        {
          "family": "Bricolage Grotesque",
          "src": "url(https://cdn.jsdelivr.net/fontsource/fonts/bricolage-grotesque:vf@latest/latin-wght-normal.woff2) format(\"woff2\")",
          "weight": "200 800",
          "style": "normal",
          "display": "swap"
        },
        {
          "family": "Space Grotesk",
          "src": "url(https://cdn.jsdelivr.net/fontsource/fonts/space-grotesk:vf@latest/latin-wght-normal.woff2) format(\"woff2\")",
          "weight": "300 700",
          "style": "normal",
          "display": "swap"
        }
      ]
    }
  },
  "color": {
    "$type": "color",
    "$description": "The light palette. Derived roles (surface, text, border) are references into the neutral ramp, so re-tinting the ramp re-tints every surface with it.",
    "primary": {
      "$value": "#1c62c2",
      "$description": "Brand accent: primary actions, links, focus rings.",
      "$modes": {
        "dark": "#8db9fa"
      }
    },
    "secondary": {
      "$value": "#1a2434",
      "$description": "Brand accent: secondary actions and highlights.",
      "$modes": {
        "dark": "#dadee5"
      }
    },
    "accent": {
      "$value": "#006974",
      "$description": "Brand accent: supporting emphasis, distinct from primary.",
      "$modes": {
        "dark": "#71c7d1"
      }
    },
    "neutral": {
      "50": {
        "$value": "#f7f8fb",
        "$modes": {
          "dark": "#0d121a"
        }
      },
      "100": {
        "$value": "#f1f4f8",
        "$modes": {
          "dark": "#131922"
        }
      },
      "200": {
        "$value": "#e4e8ef",
        "$modes": {
          "dark": "#1d242f"
        }
      },
      "300": {
        "$value": "#cfd5de",
        "$modes": {
          "dark": "#2b333f"
        }
      },
      "400": {
        "$value": "#a6afbb",
        "$modes": {
          "dark": "#434b57"
        }
      },
      "500": {
        "$value": "#78818f",
        "$modes": {
          "dark": "#6e757f"
        }
      },
      "600": {
        "$value": "#525c6a",
        "$modes": {
          "dark": "#999fa7"
        }
      },
      "700": {
        "$value": "#333e4d",
        "$modes": {
          "dark": "#bdc1c7"
        }
      },
      "800": {
        "$value": "#1a2434",
        "$modes": {
          "dark": "#dbdee2"
        }
      },
      "900": {
        "$value": "#050d1c",
        "$modes": {
          "dark": "#f3f5f8"
        }
      },
      "$description": "The grey ramp, 50 (lightest) through 900 (darkest)."
    },
    "semantic": {
      "$description": "Status colors. Named by meaning, never by hue.",
      "success": {
        "$value": "#26753e",
        "$modes": {
          "dark": "#72cf88"
        }
      },
      "warning": {
        "$value": "#886108",
        "$modes": {
          "dark": "#eac26b"
        }
      },
      "error": {
        "$value": "#a6312b",
        "$modes": {
          "dark": "#f38277"
        }
      },
      "info": {
        "$value": "#0e629a",
        "$modes": {
          "dark": "#6dbbe8"
        }
      }
    },
    "surface": {
      "$value": "{color.neutral.50}",
      "$description": "Page background.",
      "$modes": {
        "dark": "#0d121a"
      }
    },
    "surface-sunken": {
      "$value": "{color.neutral.100}",
      "$description": "Background of elements that sit below the page: table stripes, inset wells.",
      "$modes": {
        "dark": "{color.neutral.200}"
      }
    },
    "surface-raised": {
      "$value": "#ffffff",
      "$description": "Background of elements that sit above the page: cards, popovers, menus.",
      "$modes": {
        "dark": "#18202a"
      }
    },
    "text": {
      "$value": "{color.neutral.900}",
      "$description": "Default body text.",
      "$modes": {
        "dark": "#f3f5f8"
      }
    },
    "text-muted": {
      "$value": "{color.neutral.600}",
      "$description": "Secondary text: captions, helper copy, placeholders.",
      "$modes": {
        "dark": "#999fa7"
      }
    },
    "border": {
      "$value": "{color.neutral.200}",
      "$description": "Default hairline and divider.",
      "$modes": {
        "dark": "#1d242f"
      }
    },
    "scrim": {
      "$value": "rgb(15 19 30 / 45%)",
      "$description": "What dims the page behind a modal. A theme closes its dialogs over its own ink, not a neutral black.",
      "$modes": {
        "dark": "rgb(15 19 30 / 60%)"
      }
    },
    "on-primary": {
      "$value": "#ffffff",
      "$type": "color",
      "$modes": {
        "dark": "#111923"
      }
    },
    "focus-ring": {
      "$value": "#1c62c2",
      "$modes": {
        "dark": "#8db9fa"
      }
    },
    "link": {
      "$value": "#1c62c2",
      "$description": "Links read against body text, so they follow the primary.",
      "$modes": {
        "dark": "#8db9fa"
      }
    },
    "on-secondary": {
      "$type": "color",
      "$value": "#ffffff",
      "$modes": {
        "dark": "#111923"
      }
    },
    "on-accent": {
      "$type": "color",
      "$value": "#ffffff",
      "$modes": {
        "dark": "#111923"
      }
    },
    "selected": {
      "$type": "color",
      "$value": "{color.text}"
    },
    "on-selected": {
      "$type": "color",
      "$value": "{color.surface}"
    },
    "on-semantic-success": {
      "$type": "color",
      "$value": "#ffffff",
      "$modes": {
        "dark": "#111923"
      }
    },
    "on-semantic-warning": {
      "$type": "color",
      "$value": "#ffffff",
      "$modes": {
        "dark": "#111923"
      }
    },
    "field": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "A field's own surface. Distinct from `surface`, so a control reads as an inset object rather than a hole in the page, and distinct from `surface-raised`, so a card on a field is still two things.",
      "$modes": {
        "dark": "#1d242f"
      }
    },
    "border-strong": {
      "$type": "color",
      "$value": "#a6afbb",
      "$description": "A control's own edge: stronger than `border`, which divides content. A field has to read as a field at a glance.",
      "$modes": {
        "dark": "#434b57"
      }
    },
    "on-semantic-error": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "Text on the matching fill. A fill with no foreground cannot be read, which is what this token prevents.",
      "$modes": {
        "dark": "#111923"
      }
    },
    "on-danger": {
      "$type": "color",
      "$value": "{color.on-semantic-error}",
      "$description": "The legacy name for the ink on the error fill. It points at `color.on-semantic-error` \u2014 the role the contract requires, the floor is measured on, and the danger button and the danger badge wear \u2014 so the two names can never disagree."
    },
    "on-semantic-info": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "Text on the matching fill. A fill with no foreground cannot be read, which is what this token prevents.",
      "$modes": {
        "dark": "#111923"
      }
    },
    "disabled": {
      "$value": "{color.neutral.200}",
      "$description": "The fill a dead control wears: the ramp one step off the page, so a control that cannot be pressed still reads as a control rather than as a hole in the layout.",
      "$modes": {
        "dark": "{color.neutral.200}"
      }
    },
    "on-disabled": {
      "$type": "color",
      "$value": "{color.neutral.600}",
      "$description": "The ink on that fill. Dimming the control instead would dim this with it, which is how a dead button becomes an unreadable one.",
      "$modes": {
        "dark": "{color.neutral.600}"
      }
    }
  },
  "font": {
    "$description": "Typography: which face, how large, how heavy, and how open the tracking sits.",
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": "Inter, ui-sans-serif, system-ui, sans-serif",
        "$description": "Body and UI text."
      },
      "heading": {
        "$value": "{font.family.sans}",
        "$description": "The display face. Silk answers with the sans; a theme with a display voice states its own."
      },
      "body": {
        "$value": "{font.family.sans}",
        "$description": "The body face. Distinct from `sans` only when a theme wants the two to differ."
      },
      "serif": {
        "$value": "ui-serif, Georgia, Cambria, serif",
        "$description": "Long-form editorial text."
      },
      "mono": {
        "$value": "ui-monospace, SFMono-Regular, Menlo, monospace",
        "$description": "Code, identifiers, tabular figures."
      },
      "brand": {
        "$type": "fontFamily",
        "$value": "Bricolage Grotesque, Space Grotesk, ui-sans-serif, system-ui, sans-serif",
        "$description": "The logotype face — one brand, every language."
      }
    },
    "style": {
      "display": {
        "$type": "typography",
        "$description": "Display \u2014 the largest statement on the page. Hero headings (h1 reads it). Not section titles (that's title).",
        "$value": {
          "family": "{font.family.serif}",
          "size": "{font.size.3xl}",
          "weight": "{font.weight.bold}",
          "tracking": "{font.tracking.tight}",
          "leading": "{font.leading.tight}"
        }
      },
      "title": {
        "$type": "typography",
        "$description": "Title \u2014 the section title. h2 and stat figures read it. Not subsections (that's heading).",
        "$value": {
          "family": "{font.family.sans}",
          "size": "{font.size.2xl}",
          "weight": "{font.weight.semibold}",
          "tracking": "{font.tracking.normal}",
          "leading": "{font.leading.snug}"
        }
      },
      "heading": {
        "$type": "typography",
        "$description": "Heading \u2014 the subsection title. h3 reads it. Not UI labels (that's label).",
        "$value": {
          "family": "{font.family.sans}",
          "size": "{font.size.xl}",
          "weight": "{font.weight.semibold}",
          "tracking": "{font.tracking.normal}",
          "leading": "{font.leading.snug}"
        }
      },
      "subtitle": {
        "$type": "typography",
        "$description": "Subtitle \u2014 the large UI step. Large buttons (button s-lg falls back to it). Not intro paragraphs (that's lead).",
        "$value": {
          "family": "{font.family.sans}",
          "size": "{font.size.lg}",
          "weight": "{font.weight.medium}",
          "tracking": "{font.tracking.normal}",
          "leading": "{font.leading.snug}"
        }
      },
      "lead": {
        "$type": "typography",
        "$description": "Lead \u2014 the intro paragraph. Article ledes and empty-state subheads. Not default reading text (that's body).",
        "$value": {
          "family": "{font.family.sans}",
          "size": "{font.size.lg}",
          "weight": "{font.weight.regular}",
          "tracking": "{font.tracking.normal}",
          "leading": "{font.leading.relaxed}"
        }
      },
      "body": {
        "$type": "typography",
        "$description": "Body \u2014 the default reading text. Every paragraph. Not UI labels (that's label), not emphasis (that's body-emphasized).",
        "$value": {
          "family": "{font.family.sans}",
          "size": "{font.size.md}",
          "weight": "{font.weight.regular}",
          "tracking": "{font.tracking.normal}",
          "leading": "{font.leading.relaxed}"
        }
      },
      "quote": {
        "$type": "typography",
        "$description": "Quote \u2014 somebody else's words (blockquote reads it). Not default reading text (that's body).",
        "$value": {
          "family": "{font.family.serif}",
          "size": "{font.size.lg}",
          "weight": "{font.weight.regular}",
          "tracking": "{font.tracking.normal}",
          "leading": "{font.leading.relaxed}"
        }
      },
      "code": {
        "$type": "typography",
        "$description": "Code \u2014 identifiers and paths (code reads it). Monospace. Not prose of any kind.",
        "$value": {
          "family": "{font.family.mono}",
          "size": "{font.size.sm}",
          "weight": "{font.weight.regular}",
          "tracking": "{font.tracking.normal}",
          "leading": "{font.leading.normal}"
        }
      },
      "label": {
        "$type": "typography",
        "$description": "Label \u2014 the short named thing. Field labels, card headers, badges (badge falls back to it). Not annotations (that's caption).",
        "$value": {
          "family": "{font.family.sans}",
          "size": "{font.size.sm}",
          "weight": "{font.weight.medium}",
          "tracking": "{font.tracking.wide}",
          "leading": "{font.leading.snug}"
        }
      },
      "caption": {
        "$type": "typography",
        "$description": "Caption \u2014 the annotation. Timestamps, helper text, stat context. Not named emphasis (that's caption-emphasized).",
        "$value": {
          "family": "{font.family.sans}",
          "size": "{font.size.xs}",
          "weight": "{font.weight.regular}",
          "tracking": "{font.tracking.normal}",
          "leading": "{font.leading.snug}"
        }
      },
      "overline": {
        "$type": "typography",
        "$description": "Overline \u2014 the kicker above a title (h5/h6 read it). Tracked out. Not a label (that's label).",
        "$value": {
          "family": "{font.family.sans}",
          "size": "{font.size.xs}",
          "weight": "{font.weight.semibold}",
          "tracking": "{font.tracking.wider}",
          "leading": "{font.leading.snug}"
        }
      },
      "body-emphasized": {
        "$type": "typography",
        "$description": "Body, emphasized \u2014 definition terms (dt reads it). Same tuple as body except the semibold step. Not a second family (see the variant convention).",
        "$value": {
          "family": "{font.style.body.family}",
          "size": "{font.style.body.size}",
          "weight": "{font.weight.semibold}",
          "tracking": "{font.style.body.tracking}",
          "leading": "{font.style.body.leading}"
        }
      },
      "caption-emphasized": {
        "$type": "typography",
        "$description": "Caption, emphasized \u2014 figcaptions and table headers (figcaption, th read it). Same tuple as caption except the semibold step.",
        "$value": {
          "family": "{font.style.caption.family}",
          "size": "{font.style.caption.size}",
          "weight": "{font.weight.semibold}",
          "tracking": "{font.style.caption.tracking}",
          "leading": "{font.style.caption.leading}"
        }
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Elevation, as CSS box-shadow values.",
    "sm": {
      "$value": "0 1px 2px -1px rgb(15 19 30 / 0.08), 0 1px 3px 0 rgb(15 19 30 / 0.06)"
    },
    "md": {
      "$value": "0 4px 8px -2px rgb(15 19 30 / 0.10), 0 2px 4px -2px rgb(15 19 30 / 0.06)"
    },
    "lg": {
      "$value": "0 16px 40px -8px rgb(15 19 30 / 0.16), 0 4px 12px -4px rgb(15 19 30 / 0.08)"
    }
  },
  "$description": "A cool grey-blue surface and one confident blue: quiet, considered, and the same judgement in daylight and after dark."
}
