{
  "name": "@spin/theme",
  "version": "0.1.0",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/index.ts",
    "./base": "./src/base/index.ts",
    "./themes": "./src/themes/index.ts",
    "./theme-types": "./src/theme-types.d.ts"
  },
  "imports": {
    "@spin/theme": "./src/index.ts",
    "@spin/theme/base": "./src/base/index.ts",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "valibot": "npm:valibot@^1.0.0",
    "@orpc/contract": "npm:@orpc/contract@^1.0.0",
    "@orpc/server": "npm:@orpc/server@^1.0.0",
    "@sinclair/typebox": "npm:@sinclair/typebox@^0.34.0"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-net src/ tests/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "schema": "deno eval --ext=ts \"const { spinThemeJsonSchema } = await import('./src/contract/schema.ts');await Deno.writeTextFile('schema.json', JSON.stringify(spinThemeJsonSchema(), null, 2) + '\\n');console.log('wrote schema.json');\""
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable"
    ]
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-slow-types"
      ]
    }
  }
}
