{
  "name": "@spin/hooks",
  "version": "0.1.0",
  "description": "Framework bindings for spin components: Solid and React.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madvib/spin.git"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react.ts",
      "default": "./src/react.ts"
    },
    "./solid": {
      "types": "./src/solid.ts",
      "default": "./src/solid.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "solid-js": "^1.9.0"
  },
  "peerDependencies": {
    "@spin/runtime": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
