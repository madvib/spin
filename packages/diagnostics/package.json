{
  "description": "The checks: rules, linters, and the service that runs them.",
  "dependencies": {
    "oxc-parser": "^0.126.0",
    "@spinjs/components": "workspace:*",
    "@spinjs/preset": "workspace:*",
    "@spinjs/server": "workspace:*",
    "@spinjs/theme": "workspace:*",
    "@unocss/core": "66.10.5"
  },
  "exports": {
    ".": {
      "default": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./vocabulary": {
      "default": "./src/vocabulary.ts",
      "types": "./src/vocabulary.ts"
    },
    "./eslint": {
      "default": "./src/eslint.ts",
      "types": "./src/eslint.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "name": "@spinjs/diagnostics",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madvib/spin.git"
  },
  "scripts": {
    "fmt": "bunx oxfmt@0.78.0 --write .",
    "lint": "bunx oxlint@1.85.0 --config ../../.oxlintrc.json src/",
    "test": "bun test src/"
  },
  "type": "module",
  "version": "0.2.0-alpha.2",
  "devDependencies": {
    "@html-eslint/parser": "^0.68.0",
    "@typescript-eslint/parser": "8.71.0",
    "eslint": "^9.39.4",
    "svelte": "^5.57.3",
    "svelte-eslint-parser": "^1.10.1",
    "vue-eslint-parser": "^10.4.2"
  }
}
