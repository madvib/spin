{
  "name": "@spinjs/diagnostics",
  "version": "0.1.0",
  "description": "The diagnostics: the lints, the rendered checks, and the service over them.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madvib/spin.git"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./eslint": {
      "types": "./src/eslint.ts",
      "default": "./src/eslint.ts"
    },
    "./cli": {
      "types": "./src/cli.ts",
      "default": "./src/cli.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "spin": "./dist/cli.js"
  },
  "dependencies": {
    "@typescript-eslint/parser": "8.71.0"
  },
  "peerDependencies": {
    "@spinjs/animation": "workspace:*",
    "@spinjs/preset": "workspace:*",
    "@spinjs/project": "workspace:*",
    "@spinjs/runtime": "workspace:*",
    "@spinjs/theme": "workspace:*"
  },
  "devDependencies": {
    "@unocss/core": "66.10.5",
    "eslint": "^9.39.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./eslint": {
        "types": "./dist/eslint.d.ts",
        "default": "./dist/eslint.js"
      },
      "./cli": {
        "types": "./dist/cli.d.ts",
        "default": "./dist/cli.js"
      }
    }
  },
  "scripts": {
    "test": "bun test src/ tests/",
    "lint": "oxlint",
    "lint:ox": "oxlint --config .oxlintrc.json",
    "lint:cli": "bun run src/cli.ts",
    "fmt": "biome format --write ."
  }
}
