{
  "name": "@spin/runtime",
  "version": "0.1.1",
  "description": "The component runtime: signals, bridges, elements plugin, and directives.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madvib/spin.git"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./fsm": {
      "types": "./dist/machine/fsm/machine.d.ts",
      "default": "./dist/machine/fsm/machine.js"
    },
    "./load": {
      "types": "./dist/directives/load.d.ts",
      "default": "./dist/directives/load.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "default": "./dist/plugin/index.js"
    },
    "./plugin/elements": {
      "types": "./dist/plugin/elements.d.ts",
      "default": "./dist/plugin/elements.js"
    },
    "./props": {
      "types": "./dist/props.d.ts",
      "default": "./dist/props.js"
    },
    "./actions": {
      "types": "./dist/actions/index.d.ts",
      "default": "./dist/actions/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@spin/syntax": "^0.1.0",
    "alien-signals": "^3.2.1",
    "linkedom": "^0.18.0",
    "unplugin": "^3.4.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
