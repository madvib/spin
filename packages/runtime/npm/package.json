{
  "name": "@spin/runtime",
  "version": "0.1.0",
  "description": "The component runtime: signals, bridges, elements plugin, and directives.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madvib/spin.git"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./zag": {
      "types": "./dist/machine/adapter/index.d.ts",
      "default": "./dist/machine/adapter/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./adapter": {
      "types": "./dist/machine/adapter/index.d.ts",
      "default": "./dist/machine/adapter/index.js"
    },
    "./load": {
      "types": "./dist/directives/load.d.ts",
      "default": "./dist/directives/load.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "default": "./dist/plugin/index.js"
    },
    "./plugin/elements": {
      "types": "./dist/plugin/elements.d.ts",
      "default": "./dist/plugin/elements.js"
    },
    "./props": {
      "types": "./dist/props.d.ts",
      "default": "./dist/props.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "@spin/theme": "^0.1.0"
