{
  "name": "@spinjs/runtime",
  "version": "0.1.6",
  "description": "The component runtime: signals, bridges, elements, and directives.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madvib/spin.git"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    },
    "./fsm": {
      "types": "./src/machine/fsm/machine.ts",
      "default": "./src/machine/fsm/machine.ts"
    },
    "./load": {
      "types": "./src/directives/load.ts",
      "default": "./src/directives/load.ts"
    },
    "./props": {
      "types": "./src/props.ts",
      "default": "./src/props.ts"
    },
    "./actions": {
      "types": "./src/actions/index.ts",
      "default": "./src/actions/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "alien-signals": "^3.2.1",
    "linkedom": "^0.18.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "./fsm": {
        "types": "./dist/machine/fsm/machine.d.ts",
        "default": "./dist/machine/fsm/machine.js"
      },
      "./load": {
        "types": "./dist/directives/load.d.ts",
        "default": "./dist/directives/load.js"
      },
      "./props": {
        "types": "./dist/props.d.ts",
        "default": "./dist/props.js"
      },
      "./actions": {
        "types": "./dist/actions/index.d.ts",
        "default": "./dist/actions/index.js"
      }
    }
  },
  "scripts": {
    "test": "bun test src/",
    "lint": "oxlint",
    "fmt": "biome format --write ."
  }
}
