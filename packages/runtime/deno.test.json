{
  "//": "Test config. The test-only DOM lives behind a subpath so a browser consumer never loads it; this file exists so `deno test` resolves that subpath without the package having to import linkedom itself.",
  "imports": {
    "@spin/runtime": "./src/index.ts",
    "@spin/runtime/element": "./src/element.ts",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "alien-signals": "npm:alien-signals@^3.2.1",
    "@spin/runtime/testing": "./src/testing.ts",
    "linkedom": "npm:linkedom@^0.18.0",
    "unplugin": "npm:unplugin@^3.4.0",
    "@spin/runtime/fsm": "./src/machine/fsm/machine.ts",
    "@spin/runtime/actions": "./src/actions/index.ts",
    "@spin/hooks": "../../hooks/src/index.ts",
    "@spin/hooks/solid": "../../hooks/src/solid.ts"
  },
  "tasks": {
    "test": "deno test --config deno.test.json --allow-read --allow-import src/",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable"
    ]
  }
}
