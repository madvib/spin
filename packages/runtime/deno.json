{
  "name": "@spin/runtime",
  "version": "0.1.0",
  "exports": {
    ".": "./src/index.ts",
    "./zag": "./src/zag.ts",
    "./element": "./src/element.ts",
    "./testing": "./src/testing.ts"
  },
  "imports": {
    "@spin/runtime": "./src/index.ts",
    "@spin/runtime/zag": "./src/zag.ts",
    "@spin/runtime/element": "./src/element.ts",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "alien-signals": "npm:alien-signals@^3.2.1",
    "@zag-js/core": "npm:@zag-js/core@~1.44.0",
    "@zag-js/utils": "npm:@zag-js/utils@~1.44.0",
    "@zag-js/accordion": "npm:@zag-js/accordion@~1.44.0",
    "@spin/runtime/testing": "./src/testing.ts",
    "linkedom": "npm:linkedom@^0.18.0"
  },
  "tasks": {
    "test": "deno test --config deno.test.json --allow-read --allow-import src/",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable"
    ]
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-slow-types"
      ]
    }
  }
}
