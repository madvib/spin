{
  "name": "@spin/api",
  "version": "0.1.0",
  "exports": {
    ".": "./src/index.ts"
  },
  "imports": {
    "@spin/api": "./src/index.ts",
    "@spin/theme": "../theme/src/index.ts",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "valibot": "npm:valibot@^1.0.0",
    "@orpc/contract": "npm:@orpc/contract@^1.0.0",
    "@orpc/server": "npm:@orpc/server@^1.0.0",
    "@orpc/client": "npm:@orpc/client@^1.0.0",
    "@spin/preset": "../preset/src/index.ts"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-net src/ tests/",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable"
    ]
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-slow-types"
      ]
    }
  }
}
