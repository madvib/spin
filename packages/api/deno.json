{
  "name": "@spin/api",
  "version": "0.1.0",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./daemon": "./src/daemon.ts",
    "./serve": "./src/serve.ts"
  },
  "imports": {
    "@spin/api": "./src/index.ts",
    "@spin/api/client": "./src/client.ts",
    "@spin/project": "../project/src/index.ts",
    "@spin/diagnostics": "../diagnostics/src/index.ts",
    "@spin/theme": "../theme/src/index.ts",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "hono": "npm:hono@^4.13.13",
    "valibot": "npm:valibot@^1.0.0",
    "@orpc/contract": "npm:@orpc/contract@^1.0.0",
    "@orpc/server": "npm:@orpc/server@^1.0.0",
    "@orpc/client": "npm:@orpc/client@^1.0.0",
    "@spin/preset": "../preset/src/index.ts",
    "@iconify-json/carbon/icons.json": "npm:@iconify-json/carbon/icons.json",
    "@iconify-json/carbon/info.json": "npm:@iconify-json/carbon/info.json",
    "@iconify-json/lucide/icons.json": "npm:@iconify-json/lucide/icons.json",
    "@iconify-json/lucide/info.json": "npm:@iconify-json/lucide/info.json",
    "@iconify-json/material-symbols/icons.json": "npm:@iconify-json/material-symbols/icons.json",
    "@iconify-json/material-symbols/info.json": "npm:@iconify-json/material-symbols/info.json",
    "@iconify-json/ph/icons.json": "npm:@iconify-json/ph/icons.json",
    "@iconify-json/ph/info.json": "npm:@iconify-json/ph/info.json",
    "@iconify-json/tabler/icons.json": "npm:@iconify-json/tabler/icons.json",
    "@iconify-json/tabler/info.json": "npm:@iconify-json/tabler/info.json"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-net --allow-env src/ tests/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "dev": "deno run --allow-read --allow-write --allow-net --allow-env src/serve.ts",
    "serve": "deno run --allow-read --allow-write --allow-net --allow-env src/serve.ts"
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable"
    ]
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-slow-types"
      ]
    }
  }
}
