{
  "name": "@spin/api",
  "version": "0.1.0",
  "description": "The daemon: the procedures, over RPC, that spin's tools share.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madvib/spin.git"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./daemon": {
      "types": "./dist/daemon.d.ts",
      "default": "./dist/daemon.js"
    },
    "./serve": {
      "types": "./dist/serve.d.ts",
      "default": "./dist/serve.js"
    },
    "./project": {
      "types": "./dist/project-procedures.d.ts",
      "default": "./dist/project-procedures.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@iconify-json/carbon": "^1.2.28",
    "@iconify-json/lucide": "^1.2.0",
    "@iconify-json/material-symbols": "^1.2.95",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/tabler": "^1.2.42",
    "@orpc/client": "1",
    "@orpc/contract": "1",
    "@orpc/server": "1",
    "@unocss/core": "^66.10.5",
    "hono": "^4.13.13",
    "valibot": "1"
  },
  "peerDependencies": {
    "@spin/preset": "^0.1.0",
    "@spin/theme": "^0.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
