{
  "name": "@spinjs/api",
  "version": "0.1.0",
  "description": "The daemon: the procedures, over RPC, that spin's tools share.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madvib/spin.git"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./daemon": {
      "types": "./src/daemon.ts",
      "default": "./src/daemon.ts"
    },
    "./serve": {
      "types": "./src/serve.ts",
      "default": "./src/serve.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@iconify-json/carbon": "^1.2.28",
    "@iconify-json/lucide": "^1.2.0",
    "@iconify-json/material-symbols": "^1.2.95",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/tabler": "^1.2.42",
    "@orpc/client": "^1.0.0",
    "@orpc/contract": "^1.0.0",
    "@orpc/server": "^1.0.0",
    "@unocss/core": "66.10.5",
    "hono": "^4.13.13",
    "valibot": "^1.0.0"
  },
  "peerDependencies": {
    "@spinjs/components": "workspace:*",
    "@spinjs/diagnostics": "workspace:*",
    "@spinjs/preset": "workspace:*",
    "@spinjs/project": "workspace:*",
    "@spinjs/theme": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./daemon": {
        "types": "./dist/daemon.d.ts",
        "default": "./dist/daemon.js"
      },
      "./serve": {
        "types": "./dist/serve.d.ts",
        "default": "./dist/serve.js"
      },
      "./client": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      }
    }
  },
  "scripts": {
    "test": "bun test src/ tests/",
    "lint": "oxlint",
    "fmt": "biome format --write .",
    "dev": "bun run src/serve.ts",
    "serve": "bun run src/serve.ts"
  }
}
