{
  "name": "@spin/kit",
  "version": "0.1.1",
  "exports": "./src/index.ts",
  "imports": {
    "@spin/theme/themes": "../theme/src/themes/index.ts",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "solid-js": "npm:solid-js@^1.9.3",
    "solid-js/web": "npm:solid-js@^1.9.3/web",
    "solid-js/jsx-runtime": "./src/ssr-jsx.ts"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-net tests/",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "solid-js"
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-slow-types"
      ]
    }
  }
}
