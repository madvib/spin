{
  "name": "@spin/mcp",
  "version": "0.1.0",
  "description": "The MCP server over spin's procedures, for agents.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madvib/spin.git"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
