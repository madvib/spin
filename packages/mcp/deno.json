{
  "name": "@spin/mcp",
  "version": "0.1.0",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./main": "./src/main.ts"
  },
  "imports": {
    "@spin/api": "../api/src/index.ts",
    "@spin/theme": "../theme/src/index.ts",
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@1.32.1",
    "zod": "npm:zod@^3.25.0",
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-net --allow-env --allow-sys --allow-run src/ tests/",
    "start": "deno run --allow-net --allow-env src/main.ts",
    "check": "deno check src/ tests/",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "compilerOptions": {
    "strict": true
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-slow-types"
      ]
    }
  }
}
