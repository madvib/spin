{
  "name": "@spinjs/mcp",
  "version": "0.1.0",
  "description": "The MCP server over spin's procedures, for agents.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madvib/spin.git"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./main": {
      "types": "./src/main.ts",
      "default": "./src/main.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0"
  },
  "peerDependencies": {
    "@spinjs/api": "workspace:*",
    "@spinjs/theme": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./main": {
        "types": "./dist/main.d.ts",
        "default": "./dist/main.js"
      }
    }
  },
  "scripts": {
    "test": "bun test src/ tests/",
    "start": "bun run src/main.ts",
    "check": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "biome format --write ."
  }
}
