{
  "name": "@spin/mcp",
  "version": "0.1.0",
  "description": "The MCP server over spin's procedures, for agents.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madvib/spin.git"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./main": {
      "types": "./src/main.ts",
      "default": "./src/main.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@spin/api": "workspace:*",
    "@spin/theme": "workspace:*",
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "@spin/api": "workspace:*",
    "@spin/theme": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "bun test src/ tests/",
    "start": "bun run src/main.ts",
    "check": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "biome format --write ."
  }
}
