{
  "name": "@spin/workspace",
  "version": "0.1.0",
  "workspace": [
    "./packages/runtime",
    "./packages/components",
    "./packages/theme",
    "./packages/animation",
    "./packages/preset",
    "./packages/lint",
    "./packages/api",
    "./apps/studio",
    "./packages/hooks",
    "./apps/reference",
    "./examples/coffee",
    "./oracles/layout",
    "./packages/syntax"
  ],
  "exports": {
    ".": "./packages/theme/src/index.ts",
    "./preset/organization.ts": "./packages/preset/src/organization.ts",
    "./preset/reference/build.ts": "./packages/preset/src/reference/build.ts"
  },
  "imports": {
    "@spin/runtime": "./packages/runtime/src/index.ts",
    "@spin/theme": "./packages/theme/src/index.ts",
    "@spin/preset": "./packages/preset/src/index.ts",
    "@spin/lint": "./packages/lint/src/index.ts",
    "@spin/api": "./packages/api/src/index.ts",
    "@spin/components": "./packages/components/src/index.ts",
    "@std/fs/walk": "jsr:@std/fs@^1.0.0/walk",
    "@unocss/core": "npm:@unocss/core@^66.10.5",
    "@unocss/preset-wind4": "npm:@unocss/preset-wind4@^66.10.5",
    "@orpc/contract": "npm:@orpc/contract@^1.0.0",
    "@orpc/server": "npm:@orpc/server@^1.0.0",
    "unplugin": "npm:unplugin@^3.4.0",
    "valibot": "npm:valibot@^1.0.0",
    "@orpc/client": "npm:@orpc/client@^1.0.0",
    "@spin/theme/base": "./packages/theme/src/base/index.ts",
    "@spin/animation": "./packages/animation/src/index.ts",
    "@sinclair/typebox": "npm:@sinclair/typebox@^0.34.0",
    "@unocss/preset-tagify": "npm:@unocss/preset-tagify@66.10.5",
    "@unocss/preset-icons": "npm:@unocss/preset-icons@^66.10.5",
    "@iconify-json/lucide": "npm:@iconify-json/lucide@^1.2.0",
    "@zag-js/color-utils": "npm:@zag-js/color-utils@^1.44.0",
    "@zag-js/utils": "npm:@zag-js/utils@~1.44.0",
    "@spin/runtime/props": "./packages/runtime/src/props.ts",
    "@spin/runtime/load": "./packages/runtime/src/directives/load.ts",
    "@spin/runtime/fsm": "./packages/runtime/src/machine/fsm/machine.ts",
    "@spin/hooks": "./packages/hooks/src/index.ts",
    "@spin/hooks/solid": "./packages/hooks/src/solid.ts",
    "@spin/hooks/react": "./packages/hooks/src/react.ts",
    "@spin/syntax": "./packages/syntax/src/index.ts"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-net packages/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno check packages/components/src packages/components/tests packages/runtime/src packages/hooks/src packages/theme/src packages/preset/src packages/api/src packages/lint/src && (cd packages/components/specimens && deno check src/) && deno run -A scripts/uno-class-check.ts && deno run -A scripts/recipe-check.ts",
    "lint:ox": "deno run -A npm:oxlint@1.85.0 --config .oxlintrc.json packages/ apps/",
    "visual": "deno run --allow-read --allow-write --allow-net --allow-run --allow-env oracles/visual/check.ts",
    "serve": "cd apps/reference && deno task dev",
    "dev": "deno task dev:studio & deno task dev:daemon & wait",
    "dev:daemon": "cd packages/api && deno task dev --root ../../examples/fixture-app --port 0",
    "dev:studio": "cd apps/studio && deno task dev",
    "studio-check": "deno run --allow-read --allow-write --allow-net --allow-run --allow-env oracles/studio/check.ts",
    "demo:tree": "node node_modules/vite/bin/vite.js packages/components/demo",
    "coverage": "deno test --config packages/runtime/deno.test.json --allow-read --allow-import --coverage=coverage packages/runtime/src/ >/dev/null || true; deno coverage coverage --lcov || true; node scripts/coverage-summary.mjs coverage/lcov.info",
    "coverage:html": "deno test --config packages/runtime/deno.test.json --allow-read --allow-import --coverage=coverage packages/runtime/src/ >/dev/null && deno coverage coverage --html",
    "coverage:commit": "deno test --config packages/runtime/deno.test.json --allow-read --allow-import --coverage=coverage $(git diff --name-only HEAD --diff-filter=AM -- '*.ts' | grep -v node_modules | tr '\n' ' ') && deno coverage coverage --detailed",
    "check:classes": "deno run -A scripts/uno-class-check.ts",
    "check:recipes": "deno run -A scripts/recipe-check.ts"
  },
  "fmt": {
    "exclude": [
      "node_modules",
      ".omo",
      ".output"
    ]
  },
  "lint": {
    "exclude": [
      "node_modules",
      ".omo",
      ".output"
    ]
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable"
    ],
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true
  }
}
