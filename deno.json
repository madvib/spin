{
  "name": "@spin/workspace",
  "version": "0.1.0",
  "workspace": [
    "./packages/theme",
    "./packages/animation",
    "./packages/preset",
    "./packages/project",
    "./packages/diagnostics",
    "./packages/kit",
    "./packages/api",
    "./packages/mcp",
    "./apps/studio",
    "./apps/reference",
    "./apps/docs",
    "./examples/coffee"
  ],
  "exports": {
    ".": "./packages/theme/src/index.ts",
    "./preset/organization.ts": "./packages/preset/src/organization.ts",
    "./preset/reference/build.ts": "./packages/preset/src/reference/build.ts"
  },
  "imports": {
    "@spin/theme": "./packages/theme/src/index.ts",
    "@spin/preset": "./packages/preset/src/index.ts",
    "@spin/project": "./packages/project/src/index.ts",
    "@spin/project/sync": "./packages/project/src/sync.ts",
    "@spin/diagnostics": "./packages/diagnostics/src/index.ts",
    "@spin/api": "./packages/api/src/index.ts",
    "@spin/api/client": "./packages/api/src/client.ts",
    "@unocss/core": "npm:@unocss/core@^66.10.5",
    "@unocss/preset-wind4": "npm:@unocss/preset-wind4@^66.10.5",
    "@orpc/contract": "npm:@orpc/contract@^1.0.0",
    "@orpc/server": "npm:@orpc/server@^1.0.0",
    "valibot": "npm:valibot@^1.0.0",
    "@orpc/client": "npm:@orpc/client@^1.0.0",
    "@spin/theme/base": "./packages/theme/src/base/index.ts",
    "@spin/animation": "./packages/animation/src/index.ts",
    "@sinclair/typebox": "npm:@sinclair/typebox@^0.34.0",
    "@unocss/preset-tagify": "npm:@unocss/preset-tagify@66.10.5",
    "@unocss/preset-icons": "npm:@unocss/preset-icons@^66.10.5",
    "@iconify-json/lucide": "npm:@iconify-json/lucide@^1.2.0",
    "@spin/kit": "./packages/kit/src/index.ts",
    "playwright-core": "npm:playwright-core@^1.63.0"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-net --allow-env --allow-sys --allow-run packages/ apps/studio/src/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno check packages/*/src packages/*/tests internal/ scripts/",
    "build:dist": "deno run -A scripts/build-dist.ts",
    "check:dist": "deno run -A scripts/check-exports.ts",
    "lint:ox": "deno run -A npm:oxlint@1.85.0 --config .oxlintrc.json packages/ apps/",
    "visual": "cd apps/reference && deno task visual",
    "serve": "cd apps/reference && deno task dev",
    "dev": "deno task dev:studio & deno task dev:daemon & wait",
    "dev:docs": "cd apps/docs && deno task dev",
    "build:docs": "cd apps/docs && deno task build",
    "dev:daemon": "cd packages/api && deno task dev --root ../../examples/fixture-app --port 0",
    "dev:studio": "cd apps/studio && deno task dev",
    "build:studio": "cd apps/studio && deno task build",
    "skill": "cd packages/theme && deno task skill",
    "e2e": "cd apps/studio && deno task e2e"
  },
  "fmt": {
    "exclude": [
      "node_modules",
      ".omo",
      ".output",
      "dist",
      "**/.vite",
      "examples/coffee/public",
      "**/*.timestamp-*.mjs",
      "packages/theme/src/theme-types.d.ts"
    ]
  },
  "lint": {
    "exclude": [
      "node_modules",
      ".omo",
      ".output",
      "dist",
      "**/.vite",
      "**/*.timestamp-*.mjs"
    ]
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable"
    ]
  }
}
