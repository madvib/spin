{
  "name": "@spin/workspace",
  "version": "0.1.0",
  "workspace": [
    "./packages/runtime",
    "./packages/components",
    "./packages/theme",
    "./packages/animation",
    "./packages/preset",
    "./packages/lint",
    "./packages/api",
    "./apps/studio",
    "./packages/components/specimens",
    "./packages/hooks"
  ],
  "exports": {
    ".": "./packages/theme/src/index.ts",
    "./preset/organization.ts": "./packages/preset/src/organization.ts",
    "./preset/reference/build.ts": "./packages/preset/src/reference/build.ts"
  },
  "imports": {
    "@spin/runtime": "./packages/runtime/src/index.ts",
    "@spin/theme": "./packages/theme/src/index.ts",
    "@spin/preset": "./packages/preset/src/index.ts",
    "@spin/lint": "./packages/lint/src/index.ts",
    "@spin/api": "./packages/api/src/index.ts",
    "@spin/components": "./packages/components/src/index.ts",
    "@spin/runtime/zag": "./packages/runtime/src/machine/adapter/index.ts",
    "@zag-js/core": "npm:@zag-js/core@1.44.0",
    "@zag-js/carousel": "npm:@zag-js/carousel@~1.44.0",
    "@zag-js/tree-view": "npm:@zag-js/tree-view@1.44.0",
    "@unocss/core": "npm:@unocss/core@^66.10.5",
    "@unocss/preset-wind4": "npm:@unocss/preset-wind4@^66.10.5",
    "@orpc/contract": "npm:@orpc/contract@^1.0.0",
    "@orpc/server": "npm:@orpc/server@^1.0.0",
    "unplugin": "npm:unplugin@^3.4.0",
    "valibot": "npm:valibot@^1.0.0",
    "@orpc/client": "npm:@orpc/client@^1.0.0",
    "@spin/theme/base": "./packages/theme/src/base/index.ts",
    "@spin/animation": "./packages/animation/src/index.ts",
    "@sinclair/typebox": "npm:@sinclair/typebox@^0.34.0",
    "@unocss/preset-tagify": "npm:@unocss/preset-tagify@66.10.5",
    "@unocss/preset-icons": "npm:@unocss/preset-icons@^66.10.5",
    "@iconify-json/lucide": "npm:@iconify-json/lucide@^1.2.0",
    "@zag-js/types": "npm:@zag-js/types@1.44.0",
    "robot3": "npm:robot3@1.4.0",
    "@spin/runtime/adapter": "./packages/runtime/src/machine/adapter/index.ts",
    "@spin/runtime/load": "./packages/runtime/src/directives/load.ts",
    "@spin/runtime/fsm": "./packages/runtime/src/machine/fsm/fsm.ts",
    "@spin/hooks": "./packages/hooks/src/index.ts",
    "@zag-js/avatar": "npm:@zag-js/avatar@~1.44.0",
    "@zag-js/color-picker": "npm:@zag-js/color-picker@~1.44.0",
    "@zag-js/combobox": "npm:@zag-js/combobox@~1.44.0",
    "@zag-js/date-picker": "npm:@zag-js/date-picker@~1.44.0",
    "@zag-js/editable": "npm:@zag-js/editable@~1.44.0",
    "@zag-js/file-upload": "npm:@zag-js/file-upload@~1.44.0",
    "@zag-js/floating-panel": "npm:@zag-js/floating-panel@~1.44.0",
    "@zag-js/hover-card": "npm:@zag-js/hover-card@~1.44.0",
    "@zag-js/number-input": "npm:@zag-js/number-input@~1.44.0",
    "@zag-js/pagination": "npm:@zag-js/pagination@~1.44.0",
    "@zag-js/pin-input": "npm:@zag-js/pin-input@~1.44.0",
    "@zag-js/rating-group": "npm:@zag-js/rating-group@~1.44.0",
    "@zag-js/scroll-area": "npm:@zag-js/scroll-area@~1.44.0",
    "@zag-js/select": "npm:@zag-js/select@~1.44.0",
    "@zag-js/signature-pad": "npm:@zag-js/signature-pad@~1.44.0",
    "@zag-js/slider": "npm:@zag-js/slider@~1.44.0",
    "@zag-js/splitter": "npm:@zag-js/splitter@~1.44.0",
    "@zag-js/steps": "npm:@zag-js/steps@~1.44.0",
    "@zag-js/tags-input": "npm:@zag-js/tags-input@~1.44.0",
    "@zag-js/timer": "npm:@zag-js/timer@~1.44.0",
    "@zag-js/toggle-group": "npm:@zag-js/toggle-group@~1.44.0",
    "@zag-js/tour": "npm:@zag-js/tour@~1.44.0",
    "@zag-js/angle-slider": "npm:@zag-js/angle-slider@~1.44.0",
    "@zag-js/async-list": "npm:@zag-js/async-list@~1.44.0",
    "@zag-js/cascade-select": "npm:@zag-js/cascade-select@~1.44.0",
    "@zag-js/date-input": "npm:@zag-js/date-input@~1.44.0",
    "@zag-js/image-cropper": "npm:@zag-js/image-cropper@~1.44.0",
    "@zag-js/listbox": "npm:@zag-js/listbox@~1.44.0",
    "@zag-js/navigation-menu": "npm:@zag-js/navigation-menu@~1.44.0",
    "@spin/hooks/solid": "./packages/hooks/src/solid.ts",
    "@spin/hooks/react": "./packages/hooks/src/react.ts"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-net packages/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno check packages/",
    "lint:ox": "deno run -A npm:oxlint@1.85.0 --config .oxlintrc.json packages/ apps/",
    "serve": "deno run -A serve.ts",
    "demo:tree": "node node_modules/vite/bin/vite.js packages/components/demo",
    "coverage": "deno test --config packages/runtime/deno.test.json --allow-read --allow-import --coverage=coverage packages/runtime/src/ >/dev/null || true; deno coverage coverage --lcov || true; node tooling/coverage-summary.mjs coverage/lcov.info",
    "coverage:html": "deno test --config packages/runtime/deno.test.json --allow-read --allow-import --coverage=coverage packages/runtime/src/ >/dev/null && deno coverage coverage --html",
    "coverage:commit": "deno test --config packages/runtime/deno.test.json --allow-read --allow-import --coverage=coverage $(git diff --name-only HEAD --diff-filter=AM -- '*.ts' | grep -v node_modules | tr '\\n' ' ') && deno coverage coverage --detailed"
  },
  "fmt": {
    "exclude": [
      "node_modules",
      ".omo",
      ".output"
    ]
  },
  "lint": {
    "exclude": [
      "node_modules",
      ".omo",
      ".output"
    ]
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable"
    ],
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true
  }
}
