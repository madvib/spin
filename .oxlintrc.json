{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "jsPlugins": [
    "./packages/diagnostics/src/index.ts"
  ],
  "rules": {
    "spin/no-redundant-class": "error",
    "spin/prefer-theme-value": "error",
    "spin/prefer-element": "warn",
    "spin/closed-vocabulary": "error",
    "spin/no-handwritten-tokens": "error",
    "spin/no-unpaired-ink": "error"
  },
  "overrides": [
    {
      "files": [
        "apps/studio/src/**/*.ts",
        "apps/studio/src/**/*.tsx",
        "apps/docs/src/**/*.ts",
        "apps/docs/src/**/*.tsx",
        "apps/reference/src/**/*.ts",
        "apps/reference/src/**/*.tsx",
        "internal/kit/src/**/*.ts",
        "internal/kit/src/**/*.tsx"
      ],
      "rules": {
        "no-unassigned-vars": "off"
      }
    },
    {
      "files": [
        "apps/studio/src/spin-elements.d.ts",
        "apps/reference/src/spin-elements.d.ts"
      ],
      "rules": {
        "typescript/triple-slash-reference": "off"
      }
    },
    {
      "files": [
        "packages/theme/src/**/*.ts"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@spinjs/dev*",
                  "@spinjs/components*"
                ],
                "message": "theme is the value layer: zero workspace dependencies"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/theme/src/**/*.ts"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "node:*",
                  "@unocss/*"
                ],
                "message": "theme ships to a browser: no Node built-ins, no bundler"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/preset/src/**/*.ts"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/plugin/**",
                  "**/diagnostics/**",
                  "**/api/**",
                  "**/project/**",
                  "**/lsp/**",
                  "**/mcp/**"
                ],
                "message": "the preset renders downward only: theme in, CSS out, no sibling areas"
              },
              {
                "group": [
                  "@spinjs/components*"
                ],
                "message": "the preset never touches the client: tokens and rules only"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/diagnostics/src/**/*.ts"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/api/**"
                ],
                "message": "diagnostics never calls the API client: findings flow up, the client lives above"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/server/src/project/**/*.ts"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/plugin/**"
                ],
                "message": "project owns the filesystem: the bundler reads from it, never the reverse"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/components/src/**/*.ts"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@spinjs/dev*",
                  "@spinjs/theme*"
                ],
                "message": "the client is independent: no spin, no theme"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/preset/src/animation/**/*.ts"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@spinjs/dev/preset",
                  "@spinjs/dev/diagnostics",
                  "@spinjs/dev/api"
                ],
                "message": "components spend tokens; they do not know how tokens become utilities"
              },
              {
                "group": [
                  "node:*",
                  "@unocss/*"
                ],
                "message": "shipped primitives must load in a browser: no Node built-ins, no bundler"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/*.action.ts"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@spinjs/components/runtime",
                "importNames": [
                  "signal",
                  "computed",
                  "effect",
                  "batch",
                  "untrack",
                  "trigger",
                  "scope",
                  "own",
                  "bindAttr",
                  "bindProp",
                  "bindText",
                  "bindValue",
                  "bindChecked",
                  "bindDynamic",
                  "bindFor",
                  "bindIf",
                  "runAction",
                  "on",
                  "text",
                  "tpl",
                  "view",
                  "useMachine"
                ],
                "message": "action bodies run untracked: reactivity reaches actions through params and update, never through imports"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/*.test.ts"
      ],
      "rules": {
        "eslint/no-restricted-imports": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules",
    "**/dist",
    "**/public",
    ".omo",
    "**/schema.json"
  ]
}
