{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "jsPlugins": [
    "./packages/spin/src/diagnostics/index.ts"
  ],
  "rules": {
    "spin/no-redundant-class": "error",
    "spin/prefer-theme-value": "error",
    "spin/prefer-element": "warn",
    "spin/closed-vocabulary": "error",
    "spin/no-handwritten-tokens": "error",
    "spin/no-unpaired-ink": "error"
  },
  "overrides": [
    {
      "files": [
        "apps/studio/src/**/*.ts",
        "apps/studio/src/**/*.tsx",
        "apps/docs/src/**/*.ts",
        "apps/docs/src/**/*.tsx",
        "apps/reference/src/**/*.ts",
        "apps/reference/src/**/*.tsx",
        "packages/spin/src/kit/**/*.ts",
        "packages/spin/src/kit/**/*.tsx"
      ],
      "rules": {
        "no-unassigned-vars": "off"
      }
    },
    {
      "files": [
        "apps/studio/src/spin-elements.d.ts",
        "apps/reference/src/spin-elements.d.ts"
      ],
      "rules": {
        "typescript/triple-slash-reference": "off"
      }
    },
    {
      "files": [
        "packages/spin/src/theme/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@spinjs/spin/preset",
                  "@spinjs/spin/diagnostics",
                  "@spinjs/spin/api",
                  "@spinjs/spin/animation"
                ],
                "message": "theme is the value layer: it knows nothing of components, utilities, or transport"
              },
              {
                "group": [
                  "node:*",
                  "@unocss/*"
                ],
                "message": "theme ships to a browser: no Node built-ins, no bundler"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/spin/src/preset/rules/primitives/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@spinjs/spin/preset"
                ],
                "message": "the element rules live in the preset: importing the package they are part of makes a cycle"
              },
              {
                "group": [
                  "@spinjs/spin/diagnostics",
                  "@spinjs/spin/api",
                  "@spinjs/spin/mcp"
                ],
                "message": "components spend tokens; they do not know what reads them"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/spin/src/animation/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@spinjs/spin/preset",
                  "@spinjs/spin/diagnostics",
                  "@spinjs/spin/api"
                ],
                "message": "components spend tokens; they do not know how tokens become utilities"
              },
              {
                "group": [
                  "node:*",
                  "@unocss/*"
                ],
                "message": "shipped primitives must load in a browser: no Node built-ins, no bundler"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/*.action.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@spinjs/runtime",
                "importNames": [
                  "signal",
                  "computed",
                  "effect",
                  "batch",
                  "untrack",
                  "trigger",
                  "scope",
                  "own",
                  "bindAttr",
                  "bindProp",
                  "bindText",
                  "bindValue",
                  "bindChecked",
                  "bindDynamic",
                  "bindFor",
                  "bindIf",
                  "runAction",
                  "on",
                  "text",
                  "tpl",
                  "view",
                  "useMachine"
                ],
                "message": "action bodies run untracked: reactivity reaches actions through params and update, never through imports"
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "node_modules",
    "**/dist",
    ".omo",
    "**/schema.json"
  ]
}
