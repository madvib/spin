{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "jsPlugins": [
    "./packages/lint/src/index.ts"
  ],
  "rules": {
    "spin/no-redundant-class": "error",
    "spin/prefer-theme-value": "warn",
    "spin/prefer-element": "warn",
    "spin/closed-vocabulary": "error",
    "spin/no-handwritten-tokens": "error",
    "spin/no-unpaired-ink": "error"
  },
  "overrides": [
    {
      "files": [
        "packages/theme/src/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@spin/preset",
                  "@spin/lint",
                  "@spin/api",
                  "@spin/animation"
                ],
                "message": "theme is the value layer: it knows nothing of components, utilities, or transport"
              },
              {
                "group": [
                  "node:*",
                  "@unocss/*"
                ],
                "message": "theme ships to a browser: no Node built-ins, no bundler"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/preset/src/rules/primitives/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@spin/preset"
                ],
                "message": "the element rules live in the preset: importing the package they are part of makes a cycle"
              },
              {
                "group": [
                  "@spin/lint",
                  "@spin/api",
                  "@spin/mcp"
                ],
                "message": "components spend tokens; they do not know what reads them"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/animation/src/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@spin/preset",
                  "@spin/lint",
                  "@spin/api"
                ],
                "message": "components spend tokens; they do not know how tokens become utilities"
              },
              {
                "group": [
                  "node:*",
                  "@unocss/*"
                ],
                "message": "shipped primitives must load in a browser: no Node built-ins, no bundler"
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "node_modules",
    "**/dist",
    ".omo",
    "**/schema.json"
  ]
}
