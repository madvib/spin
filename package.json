{
  "name": "@spinjs/workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "internal/check",
    "internal/kit"
  ],
  "type": "module",
  "catalog": {
    "@orpc/client": "^1.0.0",
    "@orpc/contract": "^1.0.0",
    "@orpc/server": "^1.0.0",
    "valibot": "^1.0.0"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.0",
    "@orpc/client": "^1.0.0",
    "@orpc/contract": "^1.0.0",
    "@orpc/server": "^1.0.0",
    "@spinjs/components": "workspace:*",
    "@spinjs/spin": "workspace:*",
    "@unocss/core": "66.10.5",
    "@unocss/preset-icons": "66.10.5",
    "@unocss/preset-tagify": "66.10.5",
    "@unocss/preset-wind4": "66.10.5",
    "@unocss/vite": "66.10.5",
    "playwright-core": "^1.63.0",
    "typescript": "5.9.2",
    "unplugin": "^3.4.0",
    "valibot": "^1.0.0",
    "vite": "8",
    "vite-plugin-solid": "^2.11.14"
  },
  "scripts": {
    "test": "bun test --path-ignore-patterns=\"**/e2e/**\" --path-ignore-patterns=\"**/e2e.test.ts\" packages/ apps/ internal/ examples/",
    "test:launch": "bun test ./.agents/launch/launch.test.ts",
    "lint": "bun packages/spin/src/cli/main.ts lint",
    "lint:ox": "oxlint --config .oxlintrc.json packages/ apps/ internal/ examples/",
    "check": "tsc --noEmit && tsc --noEmit -p apps/docs && tsc --noEmit -p apps/studio && tsc --noEmit -p apps/reference && tsc --noEmit -p internal/check && bun run lint",
    "test:docs:e2e": "bun test --timeout 120000 apps/docs/src/tests/e2e.test.ts",
    "build:dist": "bun run scripts/build-dist.ts",
    "check:dist": "bun run scripts/check-exports.ts",
    "pack": "bun run scripts/pack.ts",
    "hooks": "bun run scripts/hooks.ts",
    "visual": "cd apps/reference && bun run visual",
    "visual:studio": "cd apps/studio && bun run visual",
    "serve": "cd apps/reference && bun run dev",
    "dev": "bun run dev:studio & bun run dev:daemon & wait",
    "dev:docs": "cd apps/docs && bun run dev",
    "build:docs": "cd apps/docs && bun run build",
    "dev:daemon": "cd packages/spin && bun run src/api/daemon.ts --root ../../examples/fixture-app --port 0",
    "dev:studio": "cd apps/studio && bun run dev",
    "build:studio": "cd apps/studio && bun run build",
    "skill": "cd packages/spin && bun run skill",
    "e2e": "cd apps/studio && bun run e2e"
  },
  "devDependencies": {
    "bun-types": "^1.4.4",
    "tsdown": "^0.23.2"
  }
}
